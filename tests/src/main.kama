// @kama/window's tests, one program (AGENTS.package.md). A failing case prints its name; the exit status is 1 when any
// failed. The headless cases need no display; the system-window cases are skipped when KAMA_WINDOW_NO_DISPLAY is set
// (a CI runner with no display). Every system window opens unfocused (quiet.kama), so a run never takes the keyboard.

import {
    core::println,
    core::env::envOr,
    window::Window, window::WindowError, window::Event, window::Key, window::PointerButton, window::Pointer,
    window::ScrollUnit, window::Mods, window::Size, window::NativeKind, window::NativeWindow,
    keyTable, buttonTable, nativeHandles, systemHandles, quietly, openOptions, focusCases, heldCases, heldSystem,
    pointerCases, mouseAt, webWindow, webFinish,
};

export { Tally, describe, summary };

type resource Tally {
    int32 runs = 0;
    int32 failures = 0;

    public ctor make() { }

    public fn void verdict(const ref string name, const ref string why) {
        this.runs = this.runs + 1;
        if (why.isEmpty()) {
            println(s: "ok   ${name}");
        } else {
            this.failures = this.failures + 1;
            println(s: "FAIL ${name}: ${why}");
        }
    }

    public const fn int32 failed() { return this.failures; }
    public const fn int32 count() { return this.runs; }
}

// A pointer as text: its kind and id, as `mouse1`, `touch5` or `pen2`.
fn string pointerName(const ref Pointer p) {
    int32 id = p.id;
    return match (p.kind) {
        case Mouse: "mouse${id}";
        case Touch: "touch${id}";
        case Pen: "pen${id}";
    };
}

// What an event is, as text, for a failure's message and for comparing. A pointer event ends in the buttons the window
// says its pointer holds, in brackets.
fn string describe(const ref Event e) {
    match (e) {
        case KeyDown(key: k, mods: m, repeat: r): { int32 kn = cast<int32>(k); return "KeyDown ${kn} ${m} ${r}"; }
        case KeyUp(key: k, mods: m): { int32 kn = cast<int32>(k); return "KeyUp ${kn} ${m}"; }
        case Text(c: c): { int32 cp = cast<int32>(c); return "Text ${cp}"; }
        case PointerMove(pointer: p, dx: dx, dy: dy): {
            string n = pointerName(p: p);
            return "PointerMove ${n} ${p.x} ${p.y} ${dx} ${dy} [${p.buttons}]";
        }
        case PointerDown(pointer: p, button: b, mods: m): {
            string n = pointerName(p: p);
            int32 bn = cast<int32>(b);
            return "PointerDown ${n} ${bn} ${m} [${p.buttons}]";
        }
        case PointerUp(pointer: p, button: b, mods: m): {
            string n = pointerName(p: p);
            int32 bn = cast<int32>(b);
            return "PointerUp ${n} ${bn} ${m} [${p.buttons}]";
        }
        case PointerCancel(pointer: p): { string n = pointerName(p: p); return "PointerCancel ${n} [${p.buttons}]"; }
        case PointerEnter(pointer: p): { string n = pointerName(p: p); return "PointerEnter ${n} [${p.buttons}]"; }
        case PointerLeave(pointer: p): { string n = pointerName(p: p); return "PointerLeave ${n} [${p.buttons}]"; }
        case Scroll(dx: dx, dy: dy, unit: u): {
            string unit = match (u) { case Lines: "lines"; case Pixels: "pixels"; };
            return "Scroll ${dx} ${dy} ${unit}";
        }
        case Resize(width: w, height: h): { return "Resize ${w} ${h}"; }
        case ScaleChanged(scale: s): { return "ScaleChanged ${s}"; }
        case Focus(focused: f): { return "Focus ${f}"; }
        case PointerLock(locked: l): { return "PointerLock ${l}"; }
        case CloseRequested: { return "CloseRequested"; }
        case Dropped(count: n): { return "Dropped ${n}"; }
    };
}

unsafe fn string next(ref Window w) {
    Optional<Event> e = w.pollEvent();
    return match (e) {
        case Some(value: v): describe(e: v);
        case None: "(empty)";
    };
}

unsafe fn void expectNext(ref Tally t, ref Window w, const ref string name, const ref string want) {
    string got = next(w: w);
    if (got == want) { t.verdict(name: name, why: ""); } else { t.verdict(name: name, why: "got `${got}`, not `${want}`"); }
}

// Posted events come back in order, continuous changes coalesced into the newest unread one of their kind.
unsafe fn void queueOrder(ref Tally t) {
    Window w = Window.headless(width: 640, height: 360);
    Size s = w.size();
    if (s.width == 640 && s.height == 360) {
        t.verdict(name: "a headless window has its size", why: "");
    } else {
        t.verdict(name: "a headless window has its size", why: "${s.width}×${s.height}");
    }
    w.pump();   // nothing behind it: no events appear
    expectNext(t: t, w: w, name: "a new headless window's queue is empty", want: "(empty)");

    w.post(event: Event::KeyDown(key: Key::KeyA, mods: Mods::Shift, repeat: false));
    w.post(event: Event::PointerMove(pointer: mouseAt(x: 10.0, y: 20.0), dx: 1.0, dy: 2.0));
    w.post(event: Event::PointerMove(pointer: mouseAt(x: 12.0, y: 25.0), dx: 2.0, dy: 5.0));
    w.post(event: Event::PointerMove(pointer: mouseAt(x: 15.0, y: 30.0), dx: 3.0, dy: 5.0));
    w.post(event: Event::PointerDown(pointer: mouseAt(x: 15.0, y: 30.0), button: PointerButton::Left, mods: 0));
    w.post(event: Event::Scroll(dx: 0.0, dy: 1.0, unit: ScrollUnit::Lines));
    w.post(event: Event::Scroll(dx: 0.0, dy: 2.0, unit: ScrollUnit::Lines));
    w.post(event: Event::Resize(width: 800, height: 600));
    w.post(event: Event::Resize(width: 1024, height: 768));
    w.post(event: Event::KeyUp(key: Key::KeyA, mods: 0));
    w.post(event: Event::Text(c: 'é'));
    w.post(event: Event::CloseRequested);

    expectNext(t: t, w: w, name: "a key down comes back first, with its mods", want: "KeyDown 4 1 false");
    expectNext(t: t, w: w, name: "three moves coalesce: the last position, the summed motion",
               want: "PointerMove mouse1 15 30 6 12 [0]");
    expectNext(t: t, w: w, name: "a click after the moves", want: "PointerDown mouse1 0 0 [1]");
    expectNext(t: t, w: w, name: "two scrolls coalesce into their sum", want: "Scroll 0 3 lines");
    expectNext(t: t, w: w, name: "two resizes coalesce into the last", want: "Resize 1024 768");
    expectNext(t: t, w: w, name: "the key up keeps its place", want: "KeyUp 4 0");
    expectNext(t: t, w: w, name: "typed text is a codepoint", want: "Text 233");
    expectNext(t: t, w: w, name: "a close request is an event", want: "CloseRequested");
    expectNext(t: t, w: w, name: "then the queue is empty", want: "(empty)");

    Size after = w.size();
    if (after.width == 1024 && after.height == 768) {
        t.verdict(name: "a posted resize sets the size", why: "");
    } else {
        t.verdict(name: "a posted resize sets the size", why: "${after.width}×${after.height}");
    }
    NativeWindow n = w.nativeHandle();
    bool none = match (n.kind()) { case None: true; case Win32: false; case X11: false; case Wayland: false;
                                 case Cocoa: false; case Canvas: false; };
    if (none) { t.verdict(name: "a headless window has no native handle", why: ""); }
    else { t.verdict(name: "a headless window has no native handle", why: "it has one"); }
}

// The plain value is made memberwise, by `of`, as kama names a memberwise ctor (its SPEC § Construction).
unsafe fn void plainValues(ref Tally t) {
    Size s = Size.of(width: 3, height: 4);
    if (s.width == 3 && s.height == 4) { t.verdict(name: "Size.of takes its width, then its height", why: ""); }
    else { t.verdict(name: "Size.of takes its width, then its height", why: "the fields are ${s.width} and ${s.height}"); }
}

// A full ring keeps what it holds and counts what followed in one Dropped(n), in order; then it takes events again. The
// ring is filled with typed text, which no held-set rule touches (WIN-2, AGENTS.window.md item 5, decision 4): a held
// key keeps a slot for its up, which held.kama's cases hold.
unsafe fn void queueDrops(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    int32 i = 0;
    while (i < 300) {
        w.post(event: Event::Text(c: 'x'));
        i = i + 1;
    }
    int32 keys = 0;
    string last = "";
    bool reading = true;
    while (reading) {
        string got = next(w: w);
        if (got == "Text 120") { keys = keys + 1; } else { last = copy got; reading = false; }
    }
    if (keys == 255 && last == "Dropped 45") {
        t.verdict(name: "a full ring keeps 255 events and reports Dropped 45 after them", why: "");
    } else {
        t.verdict(name: "a full ring keeps 255 events and reports Dropped 45 after them",
                  why: "${keys} events, then `${last}`");
    }
    expectNext(t: t, w: w, name: "the drop is reported once", want: "(empty)");
    w.post(event: Event::Focus(focused: true));
    expectNext(t: t, w: w, name: "the drained ring takes events again", want: "Focus true");
}

// A ring the reader has partly drained after a drop takes new events after the Dropped record, rather than counting
// them into it: an event that arrives then is delivered, not lost (found by kama's review, 2026-11-08, when a key up
// was lost that way; a held key's up now always has a slot, held.kama). With only the reserved slot free, a new event is
// still counted into the drop, so the ring never overwrites what is unread. Filled with typed text, as above.
unsafe fn void queueDropsPartial(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    int32 i = 0;
    while (i < 300) {
        w.post(event: Event::Text(c: 'x'));
        i = i + 1;
    }
    string first = next(w: w);   // one read: only the slot the Dropped record holds is past the reserve
    w.post(event: Event::Focus(focused: true));
    i = 1;
    while (i < 100) { string skipped = next(w: w); i = i + 1; }   // 100 read in all: room for 99 more
    w.post(event: Event::Text(c: 'a'));
    int32 keys = 0;
    string after = "";
    bool reading = true;
    while (reading) {
        string got = next(w: w);
        if (got == "Text 120") { keys = keys + 1; } else { after = copy got; reading = false; }
    }
    if (keys == 155 && after == "Dropped 46") {
        t.verdict(name: "with only the reserved slot free, a new event is counted into the drop", why: "");
    } else {
        t.verdict(name: "with only the reserved slot free, a new event is counted into the drop",
                  why: "${keys} key downs left, then `${after}`");
    }
    expectNext(t: t, w: w, name: "an event after a partial drain is delivered after the drop", want: "Text 97");
    expectNext(t: t, w: w, name: "and then the queue is empty", want: "(empty)");
}

// On the web, a window on the page's canvas (web.kama), or, under node, a refusal.
@compileFor(ARCH_WASM32)
unsafe fn void systemWindow(ref Tally t) { webWindow(t: t); }

// A system window opens, has a size and a native handle, and closes when dropped.
@compileFor(!ARCH_WASM32)
unsafe fn void systemWindow(ref Tally t) {
    string skip = envOr(name: "KAMA_WINDOW_NO_DISPLAY", dflt: "");
    if (!skip.isEmpty()) { println(s: "skip a system window (KAMA_WINDOW_NO_DISPLAY is set)"); return; }
    Result<Window, WindowError> opened = Window.openWith(title: "@kama/window test", width: 320, height: 200,
                                                         options: quietly());
    match (give opened) {
        case Ok(value: w): {
            w.pump();
            Size s = w.size();
            Size px = w.framebufferSize();
            float32 scale = w.scale();
            if (s.width > 0 && s.height > 0 && px.width > 0 && px.height > 0 && scale > 0.0) {
                t.verdict(name: "a system window opens with a size", why: "");
            } else {
                t.verdict(name: "a system window opens with a size",
                          why: "${s.width}×${s.height} logical, ${px.width}×${px.height} pixels, scale ${scale}");
            }
            NativeWindow n = w.nativeHandle();
            bool has = n.window() != null;
            if (has) { t.verdict(name: "a system window has a native handle", why: ""); }
            else { t.verdict(name: "a system window has a native handle", why: "none on this system yet"); }
        }
        case Err(error: e): {
            string why = e.message();
            t.verdict(name: "a system window opens with a size", why: why);
        }
    };
}

unsafe fn uint8 appMain() {
    Tally t = Tally.make();
    queueOrder(t: t);
    plainValues(t: t);
    queueDrops(t: t);
    queueDropsPartial(t: t);
    heldCases(t: t);
    pointerCases(t: t);
    keyTable(t: t);
    buttonTable(t: t);
    nativeHandles(t: t);
    heldSystem(t: t);
    openOptions(t: t);
    if (focusCases(t: t)) {
        systemWindow(t: t);
        systemHandles(t: t);
    }
    return webFinish(t: give t);
}

// The last line a run prints, which tools/webtest.mjs reads in the browser; the exit status.
fn uint8 summary(ref Tally t) {
    int32 runs = t.count();
    int32 failed = t.failed();
    println(s: "window tests: ${runs} cases, ${failed} failed");
    if (failed > 0) { return 1; }
    return 0;
}

fn uint8 main() { return appMain(); }
