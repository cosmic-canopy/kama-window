// WIN-4 part B: the system's pads, natively. Every pump reads them once and hands each slot to every open system window
// (decision 1), so one pump on any window fills them all, as GLFW's events do; a headless window has none. The tests
// replace the system's read with their own (decision 8), and see SDL's own path through a virtual pad SDL attaches,
// found by its name among whatever real pads are plugged in, so a run never depends on them or rumbles one.

import {
    core::println,
    core::env::envOr,
    Tally, drained, expectDrained, quietly,
    window::Window, window::WindowError, window::WindowOptions, window::Gamepad, window::PadButton, window::PadAxis,
    window::PadInfo, window::NativeWindow, window::PadRaw,
    std::collections::DynamicArray, std::encoding::utf8::decode, std::encoding::utf8::Utf8Error,
};
export { systemPadCases, noSystemPads };

extern "winseam.h";
extern fn void winseam_pads_from_system(int32 on);
extern fn void winseam_system_pad(int32 slot, int32 connected, UnsafeConstPtr<float32> buttons,
                                  UnsafeConstPtr<float32> axes, UnsafeConstPtr<cchar> name, int32 vendor, int32 product,
                                  UnsafeConstPtr<cchar> serial, UnsafeConstPtr<cchar> id, int32 caps);
extern fn int32 winseam_system_pad_rumbled(int32 slot, UnsafePtr<float32> motors, UnsafePtr<int32> milliseconds);

extern "hooks.h";
extern fn int32 windowtests_win32();
extern fn uint32 windowtests_virtual_pad(UnsafeConstPtr<cchar> name, int32 trigger_motors);
extern fn int32 windowtests_virtual_button(uint32 id, int32 button, int32 down);
extern fn int32 windowtests_virtual_axis(uint32 id, int32 axis, int32 value);
extern fn void windowtests_virtual_detach(uint32 id);
extern fn UnsafePtr windowtests_sigint_handler();
extern fn int32 windowtests_sdl_running();
extern fn int32 windowtests_virtual_rumbled(uint32 id, UnsafePtr<int32> low, UnsafePtr<int32> high, UnsafePtr<int32> left,
                                            UnsafePtr<int32> right);
extern fn int32 windowtests_send_focus(UnsafePtr hwnd, int32 focused);
extern fn uint32 windowtests_virtual_joystick(UnsafeConstPtr<cchar> name, int32 buttons, int32 axes, int32 hats);
extern fn int32 windowtests_virtual_hat(uint32 id, int32 hat, int32 value);
extern fn int32 windowtests_virtual_guid(uint32 id, UnsafePtr<uint8> into, int32 capacity);
extern fn int32 windowtests_mapping_known(UnsafeConstPtr<cchar> guid);

fn void check(ref Tally t, const ref string name, bool ok, const ref string why) {
    if (ok) { t.verdict(name: name, why: ""); } else { t.verdict(name: name, why: why); }
}

// Options for a test's system window: unfocused, as every test window is, and reading pads in the background, so the
// pad's buttons reach it though it never has the focus.
fn WindowOptions padWindow() {
    WindowOptions o = quietly();
    o.padsWhenUnfocused = true;
    return o;
}

// The system's slot `slot` set as the system would, from `pad`; `caps` what it can do: 1 rumble, 2 trigger rumble.
unsafe fn void systemPad(int32 slot, const ref Gamepad pad, const ref string name, int32 vendor, int32 product,
                         const ref string serial, const ref string id, int32 caps) {
    int32 connected = 0;
    if (pad.connected) { connected = 1; }
    winseam_system_pad(slot: slot, connected: connected, buttons: addr(of: pad.buttons[0]), axes: addr(of: pad.axes[0]),
                       name: name.cstr(), vendor: vendor, product: product, serial: serial.cstr(), id: id.cstr(),
                       caps: caps);
}

fn Gamepad pressing(PadButton button) {
    Gamepad g = Gamepad.neutral();
    g.press(button: button);
    return g;
}

// What `padInfo(slot)` says, as text: "name vendor product serial id", or "none".
unsafe fn string infoText(const ref Window w, int32 slot) {
    Optional<PadInfo> info = w.padInfo(slot: slot);
    match (info) {
        case Some(value: i): {
            int32 v = cast<int32>(i.vendor());
            int32 p = cast<int32>(i.product());
            string name = i.name();
            string serial = i.serial();
            string id = i.id();
            return "${name} ${v} ${p} ${serial} ${id}";
        }
        case None: { return "none"; }
    };
}

// The read replaced: one pump on either window reads the slot into both; a disconnect reaches both; a window opened
// while a pad is in sees it connect at its first pump; a headless window reads none of it.
@compileFor(!ARCH_WASM32)
unsafe fn void replacedRead(ref Tally t) {
    Result<Window, WindowError> openedA = Window.openWith(title: "@kama/window pads A", width: 160, height: 100,
                                                          options: padWindow());
    Result<Window, WindowError> openedB = Window.openWith(title: "@kama/window pads B", width: 160, height: 100,
                                                          options: padWindow());
    match (give openedA) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "system pads: two windows open", why: why); return; }
        case Ok(value: a): {
            match (give openedB) {
                case Err(error: e): { string why = e.message(); t.verdict(name: "system pads: two windows open", why: why); return; }
                case Ok(value: b): {
                    Window h = Window.headless(width: 64, height: 64);
                    winseam_pads_from_system(on: 0);
                    a.pump();
                    string ignored = drained(w: a);
                    ignored = drained(w: b);

                    Gamepad south = pressing(button: PadButton::South);
                    systemPad(slot: 0, pad: south, name: "a test pad", vendor: 1118, product: 2834, serial: "S-1",
                              id: "ID-1", caps: 0);
                    a.pump();
                    expectDrained(t: t, w: a, name: "a pump reads the system's pads into its window",
                                  want: "PadConnected 0; PadButtonDown 0 0");
                    expectDrained(t: t, w: b, name: "a pump reads the system's pads into every open system window",
                                  want: "PadConnected 0; PadButtonDown 0 0");
                    string info = infoText(w: a, slot: 0);
                    check(t: t, name: "a pad's info is what the system says of it", ok: info == "a test pad 1118 2834 S-1 ID-1",
                          why: "it is `${info}`");
                    h.pump();
                    expectDrained(t: t, w: h, name: "a headless window reads no system pads", want: "");
                    string headlessInfo = infoText(w: h, slot: 0);
                    check(t: t, name: "a headless window has no pad info", ok: headlessInfo == "none",
                          why: "it is `${headlessInfo}`");
                    h.postPad(slot: 0, pad: Gamepad.neutral());
                    string postedInfo = infoText(w: h, slot: 0);
                    check(t: t, name: "a headless window's posted pad has no system info, though the system has a pad there",
                          ok: postedInfo == "none", why: "it is `${postedInfo}`");

                    Gamepad gone = Gamepad.disconnected();
                    systemPad(slot: 0, pad: gone, name: "", vendor: 0, product: 0, serial: "", id: "", caps: 0);
                    b.pump();
                    expectDrained(t: t, w: a, name: "a system pad's disconnect reaches every window",
                                  want: "PadButtonUp 0 0; PadDisconnected 0");
                    expectDrained(t: t, w: b, name: "a system pad's disconnect reaches the pumped window",
                                  want: "PadButtonUp 0 0; PadDisconnected 0");
                    string goneInfo = infoText(w: a, slot: 0);
                    check(t: t, name: "a disconnected slot has no pad info", ok: goneInfo == "none",
                          why: "it is `${goneInfo}`");

                    Gamepad rest = Gamepad.neutral();
                    systemPad(slot: 3, pad: rest, name: "a second pad", vendor: 0, product: 0, serial: "", id: "ID-3",
                              caps: 0);
                    a.pump();
                    ignored = drained(w: a);
                    Result<Window, WindowError> openedC = Window.openWith(title: "@kama/window pads C", width: 160,
                                                                         height: 100, options: padWindow());
                    match (give openedC) {
                        case Ok(value: c): {
                            c.pump();
                            expectDrained(t: t, w: c, name: "a window opened while a pad is in sees it connect at its first pump",
                                          want: "PadConnected 3");
                            string noInfo = infoText(w: c, slot: 3);
                            check(t: t, name: "a pad's info without a vendor reads 0, and without a serial reads empty",
                                  ok: noInfo == "a second pad 0 0  ID-3", why: "it is `${noInfo}`");
                        }
                        case Err(error: e): {
                            string why = e.message();
                            t.verdict(name: "a window opened while a pad is in sees it connect at its first pump", why: why);
                        }
                    };
                    winseam_pads_from_system(on: 1);
                    b.pump();
                    string back = drained(w: b);
                    check(t: t, name: "back to the system, the test's slots are emptied",
                          ok: back.contains(substring: "PadDisconnected 3"), why: "got `${back}`");
                }
            };
        }
    };
}

@compileFor(ARCH_WASM32)
unsafe fn void replacedRead(ref Tally t) { }

// What the system's slot was last asked to rumble: "strong weak left right milliseconds", "" when never.
unsafe fn string rumbledText(int32 slot) {
    InlineArray<float32>#(4) motors = [0.0; 4];
    int32 ms = 0;
    int32 asked = winseam_system_pad_rumbled(slot: slot, motors: addr(of: motors[0]), milliseconds: addr(of: ms));
    if (asked == 0) { return ""; }
    float32 strong = motors[0];
    float32 weak = motors[1];
    float32 left = motors[2];
    float32 right = motors[3];
    return "${strong} ${weak} ${left} ${right} ${ms}";
}

// Rumble (decision 7), through the replaced read: a headless window has none; an unfocused window's is refused while
// pads are not read in the background (decision 5); a pad without a motor refuses its rumble; values are clamped to 0
// to 1; and a focus loss stops what the window started. The focus is given and taken by window messages, so the
// window never takes the real focus.
@compileFor(!ARCH_WASM32)
unsafe fn void rumbleCases(ref Tally t) {
    Result<Window, WindowError> opened = Window.openWith(title: "@kama/window rumble", width: 160, height: 100,
                                                         options: quietly());
    match (give opened) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "rumble: a window opens", why: why); }
        case Ok(value: w): {
            Gamepad rest = Gamepad.neutral();
            systemPad(slot: 0, pad: rest, name: "a rumbling pad", vendor: 0, product: 0, serial: "", id: "R-0", caps: 1);
            systemPad(slot: 1, pad: rest, name: "a pad with trigger motors", vendor: 0, product: 0, serial: "",
                      id: "R-1", caps: 3);
            w.pump();
            string ignored = drained(w: w);
            Window h = Window.headless(width: 64, height: 64);
            h.postPad(slot: 0, pad: Gamepad.neutral());
            check(t: t, name: "a headless window rumbles nothing, though the system has a pad with motors in the slot",
                  ok: !h.rumble(slot: 0, strong: 1.0, weak: 1.0, milliseconds: 100) && rumbledText(slot: 0) == "",
                  why: "it took one");
            check(t: t, name: "unfocused, with pads not read in the background, a rumble is refused",
                  ok: !w.rumble(slot: 0, strong: 1.0, weak: 0.5, milliseconds: 200) && rumbledText(slot: 0) == "",
                  why: "it was taken");
            NativeWindow n = w.nativeHandle();
            UnsafePtr hwnd = n.window();
            windowtests_send_focus(hwnd: hwnd, focused: 1);
            w.pump();
            ignored = drained(w: w);
            bool took = w.rumble(slot: 0, strong: 1.0, weak: 0.25, milliseconds: 300);
            string first = rumbledText(slot: 0);
            check(t: t, name: "focused, a rumble is taken, its motors and length as asked", ok: took && first == "1 0.25 0 0 300",
                  why: "took ${took}, `${first}`");
            took = w.rumble(slot: 0, strong: 2.0, weak: -1.0, milliseconds: 100);
            string clamped = rumbledText(slot: 0);
            check(t: t, name: "a rumble's strengths are clamped to 0 to 1", ok: took && clamped == "1 0 0 0 100",
                  why: "`${clamped}`");
            check(t: t, name: "a pad without trigger motors refuses a trigger rumble",
                  ok: !w.rumbleTriggers(slot: 0, left: 1.0, right: 1.0, milliseconds: 100), why: "it took one");
            took = w.rumbleTriggers(slot: 1, left: 0.5, right: 0.75, milliseconds: 250);
            string triggers = rumbledText(slot: 1);
            check(t: t, name: "a pad with trigger motors takes a trigger rumble", ok: took && triggers == "0 0 0.5 0.75 250",
                  why: "took ${took}, `${triggers}`");
            check(t: t, name: "an empty slot rumbles nothing", ok: !w.rumble(slot: 5, strong: 1.0, weak: 1.0, milliseconds: 100),
                  why: "it took one");
            Optional<PadInfo> plain = w.padInfo(slot: 0);
            Optional<PadInfo> full = w.padInfo(slot: 1);
            bool plainCaps = match (plain) { case Some(value: i): i.rumble() && !i.triggerRumble(); case None: false; };
            bool fullCaps = match (full) { case Some(value: i): i.rumble() && i.triggerRumble(); case None: false; };
            check(t: t, name: "a pad's info says which rumble it has", ok: plainCaps && fullCaps, why: "it does not");

            windowtests_send_focus(hwnd: hwnd, focused: 0);
            w.pump();
            string stopped = rumbledText(slot: 0);
            string stoppedTriggers = rumbledText(slot: 1);
            check(t: t, name: "a focus loss stops each rumble the window started",
                  ok: stopped == "0 0 0 0 0" && stoppedTriggers == "0 0 0 0 0",
                  why: "slot 0 `${stopped}`, slot 1 `${stoppedTriggers}`");

            w.setPadsWhenUnfocused(on: true);
            took = w.rumble(slot: 0, strong: 0.5, weak: 0.5, milliseconds: 400);
            string behind = rumbledText(slot: 0);
            check(t: t, name: "unfocused, with pads read in the background, a rumble is taken",
                  ok: took && behind == "0.5 0.5 0 0 400", why: "took ${took}, `${behind}`");
            w.setPadsWhenUnfocused(on: false);
            string offAgain = rumbledText(slot: 0);
            check(t: t, name: "turned off while unfocused, background reads stop the window's rumbles too",
                  ok: offAgain == "0 0 0 0 0", why: "`${offAgain}`");
        }
    };
}

@compileFor(ARCH_WASM32)
unsafe fn void rumbleCases(ref Tally t) { }

// A virtual pad's GUID as SDL writes it.
unsafe fn string virtualGuid(uint32 id) {
    InlineArray<uint8>#(64) buffer = [0; 64];
    int32 n = windowtests_virtual_guid(id: id, into: addr(of: buffer[0]), capacity: 64);
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize i = 0;
    while (i < cast<isize>(n)) { bytes.add(item: buffer[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    return match (give r) { case Ok(value: t): give t; case Err(error: e): ""; };
}

unsafe fn bool mapped(const ref Window w, int32 slot) {
    Optional<PadInfo> info = w.padInfo(slot: slot);
    return match (info) { case Some(value: i): i.mapped(); case None: false; };
}

// The mapping (decision 3): SDL's pad database ships with the package, a pad no mapping knows is read raw, and a
// mapping added while the program runs maps it in place and is kept across SDL's restarts.
@compileFor(!ARCH_WASM32)
unsafe fn void mappingCases(ref Tally t) {
    if (windowtests_win32() != 1) { println(s: "skip the pad mappings (SDL is vendored on Windows so far)"); return; }
    string kept = "03000000ffff0000eeee000000000000";
    Result<Window, WindowError> opened = Window.openWith(title: "@kama/window mappings", width: 160, height: 100,
                                                         options: padWindow());
    match (give opened) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "mappings: a window opens", why: why); }
        case Ok(value: w): {
            winseam_pads_from_system(on: 1);
            w.pump();
            string ignored = drained(w: w);
            string nes = "03000000000f00000100000000000000";
            check(t: t, name: "SDL's pad database ships with the package: a pad SDL's own list lacks is mapped",
                  ok: windowtests_mapping_known(guid: nes.cstr()) == 1, why: "SDL has no mapping for it");

            string rawName = "kama-window raw pad";
            uint32 j = windowtests_virtual_joystick(name: rawName.cstr(), buttons: 3, axes: 2, hats: 1);
            w.pump();
            int32 s = slotNamed(w: w, name: rawName);
            string arrived = drained(w: w);
            check(t: t, name: "a pad no mapping knows connects in a slot, and says it is not mapped",
                  ok: j != 0 && s >= 0 && arrived.contains(substring: "PadConnected ${s}") && !mapped(w: w, slot: s),
                  why: "slot ${s}, events `${arrived}`");
            if (s < 0) { windowtests_virtual_detach(id: j); return; }
            windowtests_virtual_button(id: j, button: 2, down: 1);
            windowtests_virtual_axis(id: j, axis: 1, value: -32768);
            windowtests_virtual_hat(id: j, hat: 0, value: 1);
            w.pump();
            string rawEvents = drained(w: w);
            check(t: t, name: "a pad no mapping knows makes no button events: its buttons have no names",
                  ok: !rawEvents.contains(substring: "PadButtonDown ${s}"), why: "events `${rawEvents}`");
            PadRaw r = w.padRaw(slot: s);
            check(t: t, name: "its raw view has its controls, numbered as the system numbers them",
                  ok: r.buttonCount == 3 && r.axisCount == 2 && r.hatCount == 1 && r.button(index: 2) && !r.button(index: 0)
                      && r.axis(index: 1) == -1.0 && r.axis(index: 0) == 0.0 && r.hat(index: 0) == 1,
                  why: "${r.buttonCount} buttons, ${r.axisCount} axes, ${r.hatCount} hats, or a value read otherwise");
            Gamepad still = w.pad(slot: s);
            check(t: t, name: "its standard view stays at rest", ok: !still.pressed(button: PadButton::South)
                  && still.axis(axis: PadAxis::LeftY) == 0.0, why: "it moved");
            w.setPadsWhenUnfocused(on: false);
            PadRaw closed = w.padRaw(slot: s);
            check(t: t, name: "unfocused, with pads not read in the background, the raw view reads neutral but keeps its counts",
                  ok: closed.buttonCount == 3 && !closed.button(index: 2) && closed.axis(index: 1) == 0.0 && closed.hat(index: 0) == 0,
                  why: "it reads the pad");
            w.setPadsWhenUnfocused(on: true);
            w.pump();
            ignored = drained(w: w);

            string guid = virtualGuid(id: j);
            int32 took = Window::addPadMappings(text: "${guid},kama remapped pad,a:b2,b:b0,leftx:a0,lefty:a1,platform:Windows,");
            w.pump();
            string remapped = drained(w: w);
            int32 renamed = slotNamed(w: w, name: "kama remapped pad");
            check(t: t, name: "a mapping added while the program runs maps the pad in place, in its slot",
                  ok: took == 1 && renamed == s && mapped(w: w, slot: s)
                      && remapped.contains(substring: "PadButtonDown ${s} 0") && !remapped.contains(substring: "PadConnected"),
                  why: "took ${took}, slot ${renamed}, events `${remapped}`");
            Gamepad now = w.pad(slot: s);
            check(t: t, name: "the mapped pad reads its sticks through the mapping", ok: now.axis(axis: PadAxis::LeftY) == -1.0,
                  why: "LeftY reads otherwise");
            check(t: t, name: "text with no mapping in it adds none", ok: Window::addPadMappings(text: "not a mapping") == 0,
                  why: "it added one");
            int32 tookKept = Window::addPadMappings(text: "${kept},kama kept mapping,a:b0,platform:Windows,");
            check(t: t, name: "a mapping for a pad not plugged in is taken", ok: tookKept == 1 && windowtests_mapping_known(guid: kept.cstr()) == 1,
                  why: "took ${tookKept}");
            windowtests_virtual_detach(id: j);
            w.pump();
            ignored = drained(w: w);
        }
    };
    Result<Window, WindowError> again = Window.openWith(title: "@kama/window mappings again", width: 160, height: 100,
                                                        options: padWindow());
    match (give again) {
        case Ok(value: w): {
            check(t: t, name: "a mapping added while the program runs is kept when SDL restarts",
                  ok: windowtests_mapping_known(guid: kept.cstr()) == 1, why: "SDL forgot it");
        }
        case Err(error: e): { string why = e.message(); t.verdict(name: "mappings: a window opens again", why: why); }
    };
}

@compileFor(ARCH_WASM32)
unsafe fn void mappingCases(ref Tally t) { }

// The slot whose pad SDL names `name`, or -1.
unsafe fn int32 slotNamed(const ref Window w, const ref string name) {
    int32 slot = 0;
    while (slot < Window::PadSlots) {
        Optional<PadInfo> info = w.padInfo(slot: slot);
        bool named = match (info) { case Some(value: i): i.name() == name; case None: false; };
        if (named) { return slot; }
        slot = slot + 1;
    }
    return -1;
}

// SDL's own path: a virtual pad SDL's joystick layer reads, mapped by SDL to the standard layout and read by the
// package's backend like any other. Windows only, until WIN-12 vendors SDL for Linux and macOS.
@compileFor(!ARCH_WASM32)
unsafe fn void virtualPad(ref Tally t) {
    if (windowtests_win32() != 1) { println(s: "skip SDL's virtual pad (SDL is vendored on Windows so far)"); return; }
    int32 runningBefore = windowtests_sdl_running();
    check(t: t, name: "SDL stops with the last system window", ok: runningBefore == 0,
          why: "SDL is still up after every earlier window closed");
    UnsafePtr sigintBefore = windowtests_sigint_handler();
    Result<Window, WindowError> opened = Window.openWith(title: "@kama/window SDL pad", width: 160, height: 100,
                                                         options: padWindow());
    UnsafePtr sigintAfter = windowtests_sigint_handler();
    int32 runningAfter = windowtests_sdl_running();
    check(t: t, name: "SDL starts with a system window, and leaves the program's Ctrl+C handler alone",
          ok: runningAfter == 1 && sigintAfter == sigintBefore, why: "SDL running ${runningAfter}, or SIGINT's handler changed");
    match (give opened) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "SDL's virtual pad: a window opens", why: why); }
        case Ok(value: w): {
            winseam_pads_from_system(on: 1);
            w.pump();
            string before = drained(w: w);
            string name = "kama-window virtual pad";
            uint32 id = windowtests_virtual_pad(name: name.cstr(), trigger_motors: 1);
            check(t: t, name: "SDL attaches a virtual pad once a system window is open", ok: id != 0,
                  why: "SDL refused, or was not started");
            if (id == 0) { return; }
            w.pump();
            int32 s = slotNamed(w: w, name: name);
            string connected = drained(w: w);
            check(t: t, name: "SDL's pad connects in a slot, named as SDL names it",
                  ok: s >= 0 && connected.contains(substring: "PadConnected ${s}"), why: "slot ${s}, events `${connected}`");
            if (s < 0) { windowtests_virtual_detach(id: id); return; }

            int32 sdlSouth = 0;
            int32 sdlBack = 4;
            int32 sdlDpadLeft = 13;
            int32 sdlLeftX = 0;
            int32 sdlRightTrigger = 5;
            windowtests_virtual_button(id: id, button: sdlSouth, down: 1);
            windowtests_virtual_button(id: id, button: sdlBack, down: 1);
            windowtests_virtual_button(id: id, button: sdlDpadLeft, down: 1);
            windowtests_virtual_axis(id: id, axis: sdlRightTrigger, value: 32767);
            windowtests_virtual_axis(id: id, axis: sdlLeftX, value: -32768);
            w.pump();
            string pressed = drained(w: w);
            check(t: t, name: "SDL's buttons arrive in the standard layout: South, Back, DpadLeft, the right trigger",
                  ok: pressed.contains(substring: "PadButtonDown ${s} 0") && pressed.contains(substring: "PadButtonDown ${s} 8")
                      && pressed.contains(substring: "PadButtonDown ${s} 14") && pressed.contains(substring: "PadButtonDown ${s} 7"),
                  why: "events `${pressed}`");
            Gamepad g = w.pad(slot: s);
            check(t: t, name: "SDL's trigger reads 0 to 1, and its stick -1 to 1",
                  ok: g.value(button: PadButton::RightTrigger) == 1.0 && g.axis(axis: PadAxis::LeftX) == -1.0
                      && g.axis(axis: PadAxis::RightX) == 0.0,
                  why: "the trigger or a stick read otherwise");

            Optional<PadInfo> sdlInfo = w.padInfo(slot: s);
            bool both = match (sdlInfo) { case Some(value: i): i.rumble() && i.triggerRumble(); case None: false; };
            check(t: t, name: "SDL's pad says it has rumble and trigger rumble, as SDL says", ok: both,
                  why: "it does not");
            bool took = w.rumble(slot: s, strong: 1.0, weak: 0.25, milliseconds: 100);
            int32 low = 0;
            int32 high = 0;
            int32 left = 0;
            int32 right = 0;
            int32 asked = windowtests_virtual_rumbled(id: id, low: addr(of: low), high: addr(of: high), left: addr(of: left),
                                                      right: addr(of: right));
            check(t: t, name: "a rumble reaches SDL's pad: strong the low-frequency motor, weak the high, 0 to 65535",
                  ok: took && asked == 1 && low == 65535 && high == 16384,
                  why: "took ${took}, ${asked} asked, low ${low}, high ${high}");
            bool tookTriggers = w.rumbleTriggers(slot: s, left: 0.5, right: 1.0, milliseconds: 100);
            asked = windowtests_virtual_rumbled(id: id, low: addr(of: low), high: addr(of: high), left: addr(of: left),
                                                right: addr(of: right));
            check(t: t, name: "a trigger rumble reaches SDL's pad, left and right",
                  ok: tookTriggers && asked == 2 && left == 32768 && right == 65535,
                  why: "took ${tookTriggers}, ${asked} asked, left ${left}, right ${right}");

            string guid = virtualGuid(id: id);
            int32 renamedTook = Window::addPadMappings(text: "${guid},kama renamed pad,a:b0,b:b1,platform:Windows,");
            w.pump();
            int32 renamed = slotNamed(w: w, name: "kama renamed pad");
            check(t: t, name: "a mapping added for a mapped pad takes over, its name with it, in the same slot",
                  ok: renamedTook == 1 && renamed == s, why: "took ${renamedTook}, slot ${renamed}");

            windowtests_virtual_detach(id: id);
            w.pump();
            string gone = drained(w: w);
            check(t: t, name: "SDL's pad detached releases its buttons, then disconnects",
                  ok: gone.contains(substring: "PadButtonUp ${s} 0") && gone.contains(substring: "PadDisconnected ${s}"),
                  why: "events `${gone}`");

            // Slots: a new pad takes the lowest free, so one arriving after a pad left takes the slot it left.
            string nameA = "kama-window pad A";
            string nameB = "kama-window pad B";
            string nameC = "kama-window pad C";
            uint32 a = windowtests_virtual_pad(name: nameA.cstr(), trigger_motors: 1);
            w.pump();
            uint32 b = windowtests_virtual_pad(name: nameB.cstr(), trigger_motors: 0);
            w.pump();
            int32 sa = slotNamed(w: w, name: nameA);
            int32 sb = slotNamed(w: w, name: nameB);
            windowtests_virtual_detach(id: a);
            w.pump();
            uint32 c = windowtests_virtual_pad(name: nameC.cstr(), trigger_motors: 1);
            w.pump();
            int32 sc = slotNamed(w: w, name: nameC);
            int32 sbAfter = slotNamed(w: w, name: nameB);
            string slotsNow = allNames(w: w);
            Optional<PadInfo> plainB = w.padInfo(slot: sbAfter);
            bool onlyDual = match (plainB) { case Some(value: i): i.rumble() && !i.triggerRumble(); case None: false; };
            check(t: t, name: "SDL's pad without trigger motors says so", ok: onlyDual, why: "it says otherwise");
            check(t: t, name: "a new pad takes the lowest free slot: the one a pad just left, while the others keep theirs",
                  ok: sa >= 0 && sb > sa && sc == sa && sbAfter == sb, why: "A ${sa}, B ${sb} then ${sbAfter}, C ${sc}; ids ${a} ${b} ${c}; slots ${slotsNow}");
            windowtests_virtual_detach(id: b);
            windowtests_virtual_detach(id: c);
            w.pump();
            string ignored = drained(w: w);
        }
    };
}

@compileFor(ARCH_WASM32)
unsafe fn void virtualPad(ref Tally t) { }

unsafe fn void systemPadCases(ref Tally t) {
    string skip = envOr(name: "KAMA_WINDOW_NO_DISPLAY", dflt: "");
    if (!skip.isEmpty()) { println(s: "skip the system's pads (KAMA_WINDOW_NO_DISPLAY is set)"); return; }
    replacedRead(t: t);
    winseam_pads_from_system(on: 0);
    rumbleCases(t: t);
    virtualPad(t: t);
    mappingCases(t: t);
    winseam_pads_from_system(on: 0);
}

// The run reads no real pad but where a case asks for one (decision 8): the system's read is replaced by an empty table
// from the start, so no case's queue depends on what is plugged into the machine running it, and none rumbles one.
unsafe fn void noSystemPads() { winseam_pads_from_system(on: 0); }

// Every slot's pad name, for a failure's message: "slot=name; ...".
unsafe fn string allNames(const ref Window w) {
    string all = "";
    int32 slot = 0;
    while (slot < Window::PadSlots) {
        Optional<PadInfo> info = w.padInfo(slot: slot);
        match (info) {
            case Some(value: i): { string n = i.name(); all = "${all}${slot}=${n}; "; }
            case None: { }
        };
        slot = slot + 1;
    }
    return all;
}
