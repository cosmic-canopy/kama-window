    string wMetaRight = keyWritten(name: "MetaRight", number: 231);
    if (!wMetaRight.isEmpty()) { wrong = wrong + " MetaRight: " + wMetaRight + ";"; }
    checked = checked + 1;
    string name = "every Key reads and writes by its name (${checked} names)";
    if (wrong.isEmpty()) { t.verdict(name: name, why: ""); } else { t.verdict(name: name, why: "wrong:" + wrong); }
    string bad = "\"Arrowup\"";
    Result<Key, Owned<Error>> read = deserializeJsonBuffer::<Key>(src: copy bad, strict: true);
    string refusal = "";
    match (read) {
        case Ok(value: v): {
            int32 got = cast<int32>(v);
            refusal = "read as ${got}";
        }
        case Err(error: e): { refusal = e.message(); }
    };
    string listed = "`Arrowup` is not a `Key`";
    string named = "`ArrowUp`";
    string refusedName = "a misspelt Key (`Arrowup`) is refused with the names listed";
    if (refusal.contains(substring: listed) && refusal.contains(substring: named)) { t.verdict(name: refusedName, why: ""); }
    else { t.verdict(name: refusedName, why: "the refusal: " + refusal); }
}

// Every PadButton by name: 17 names.
fn void padButtonNames(ref Tally t) {
    string wrong = "";
    int32 checked = 0;
    string rSouth = padButtonWrong(name: "South", number: 0);
    if (!rSouth.isEmpty()) { wrong = wrong + " South: " + rSouth + ";"; }
    string wSouth = padButtonWritten(name: "South", number: 0);
    if (!wSouth.isEmpty()) { wrong = wrong + " South: " + wSouth + ";"; }
    checked = checked + 1;
    string rEast = padButtonWrong(name: "East", number: 1);
    if (!rEast.isEmpty()) { wrong = wrong + " East: " + rEast + ";"; }
    string wEast = padButtonWritten(name: "East", number: 1);
    if (!wEast.isEmpty()) { wrong = wrong + " East: " + wEast + ";"; }
    checked = checked + 1;
    string rWest = padButtonWrong(name: "West", number: 2);
    if (!rWest.isEmpty()) { wrong = wrong + " West: " + rWest + ";"; }
    string wWest = padButtonWritten(name: "West", number: 2);
    if (!wWest.isEmpty()) { wrong = wrong + " West: " + wWest + ";"; }
    checked = checked + 1;
    string rNorth = padButtonWrong(name: "North", number: 3);
    if (!rNorth.isEmpty()) { wrong = wrong + " North: " + rNorth + ";"; }
    string wNorth = padButtonWritten(name: "North", number: 3);
    if (!wNorth.isEmpty()) { wrong = wrong + " North: " + wNorth + ";"; }
    checked = checked + 1;
    string rLeftShoulder = padButtonWrong(name: "LeftShoulder", number: 4);
    if (!rLeftShoulder.isEmpty()) { wrong = wrong + " LeftShoulder: " + rLeftShoulder + ";"; }
    string wLeftShoulder = padButtonWritten(name: "LeftShoulder", number: 4);
