// A key's number is not its name: a record names a key, so a HID id in its place is refused.
fn void keyNumberRefused(ref Tally t) {
    Result<Key, Owned<Error>> read = deserializeJsonBuffer::<Key>(src: "82", strict: true);
    string why = "";
    match (read) {
        case Ok(value: v): {
            int32 got = cast<int32>(v);
            why = "read as ${got}";
        }
        case Err(error: e): { }
    };
    t.verdict(name: "a key's number in place of its name is refused", why: why);
}

fn void nameCases(ref Tally t) {
    keyNames(t: t);
    padButtonNames(t: t);
    padAxisNames(t: t);
    pointerButtonNames(t: t);
    keyNumberRefused(t: t);
}
