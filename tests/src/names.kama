// WIN-25: a key's and a button's name. A bindings record names a control by the package's own names (kyoten's
// docs/design/input.md, 2026-11-21), so each enum reads and writes each case by its name, and a misspelling is refused
// with the names listed. The names and numbers are written here, not taken from the enums, so a case renamed in the
// package fails here by name: a saved binding would stop reading.

import {
    std::memory::Owned,
    std::serialization::text::json::serializeJsonBuffer, std::serialization::text::json::deserializeJsonBuffer,
    Tally, window::Key, window::PadButton, window::PadAxis, window::PointerButton,
};
export { nameCases };

// a key: its name read back to its number, and its number written as its name; "" when both hold.
fn string keyWrong(const ref string name, int32 number) {
    string text = "\"" + name + "\"";
    Result<Key, Owned<Error>> read = deserializeJsonBuffer::<Key>(src: copy text, strict: true);
    string why = match (read) {
        case Ok(value: v): {
            int32 got = cast<int32>(v);
            if (got == number) { return ""; }
            return "read as ${got}";
        }
        case Err(error: e): e.message();
    };
    return why;
}

fn string keyWritten(const ref string name, int32 number) {
    Optional<Key> c = try cast<Key>(cast<uint16>(number));
    match (c) {
        case Some(value: v): {
            Result<string, Owned<Error>> r = serializeJsonBuffer(v: v);
            match (r) {
                case Ok(value: t): {
                    string want = "\"" + name + "\"";
                    if (t == want) { return ""; }
                    return "${number} written as " + t;
                }
                case Err(error: e): { return "${number} not written"; }
            };
        }
        case None: { return "no case numbered ${number}"; }
    };
}

