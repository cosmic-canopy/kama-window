// WIN-4: gamepads (ROADMAP_DETAIL.md § WIN-4). A window keeps its own view of each pad: a sample the system reads, or a
// program posts, is compared with what the consumer has seen, so each button's down and up is an event paired as a
// key's are (decision 2), and the whole pad is state read after each pump. A focus change releases what a pad holds
// before the keys (decision 6), and while the window is unfocused a pad reads neutral unless the program asked for pads
// in the background (decision 5).
//
// The cases post samples to a headless window, so they run on every leg with no device; one opens system windows
// natively, unfocused (quiet.kama), to see the focus they start with.

import {
    core::println,
    core::env::envOr,
    Tally, describe, expectDrained, mouseAt, quietly,
    window::Window, window::WindowError, window::WindowOptions, window::Event, window::Key, window::PointerButton,
    window::Gamepad, window::PadButton, window::PadAxis, window::PadRaw,
};
export { padCases };

// A connected pad, at rest, with `button` fully pressed.
fn Gamepad pressing(PadButton button) {
    Gamepad g = Gamepad.neutral();
    g.press(button: button);
    return g;
}

fn void check(ref Tally t, const ref string name, bool ok, const ref string why) {
    if (ok) { t.verdict(name: name, why: ""); } else { t.verdict(name: name, why: why); }
}

// Decision 2: a pad's connection and each button's down and up are events; the whole pad is state.
unsafe fn void connectAndPress(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    Gamepad before = w.pad(slot: 0);
    check(t: t, name: "an empty slot reads disconnected", ok: !before.connected, why: "it reads connected");

    w.postPad(slot: 0, pad: Gamepad.neutral());
    expectDrained(t: t, w: w, name: "a pad's first sample connects it", want: "PadConnected 0");
    Gamepad now = w.pad(slot: 0);
    check(t: t, name: "a connected pad reads connected", ok: now.connected, why: "it reads disconnected");

    w.postPad(slot: 0, pad: Gamepad.neutral());
    expectDrained(t: t, w: w, name: "the same sample again is no event", want: "");

    w.postPad(slot: 0, pad: pressing(button: PadButton::South));
    expectDrained(t: t, w: w, name: "a button pressed in a sample is a down", want: "PadButtonDown 0 0");
    Gamepad held = w.pad(slot: 0);
    check(t: t, name: "the pressed button reads pressed, at its value",
          ok: held.pressed(button: PadButton::South) && held.value(button: PadButton::South) == 1.0
              && !held.pressed(button: PadButton::East),
          why: "South does not read pressed at 1");

    w.postPad(slot: 0, pad: pressing(button: PadButton::South));
    expectDrained(t: t, w: w, name: "a button still pressed is no second down", want: "");

    w.postPad(slot: 0, pad: Gamepad.neutral());
    expectDrained(t: t, w: w, name: "a button released in a sample is an up", want: "PadButtonUp 0 0");

    w.postPad(slot: 0, pad: pressing(button: PadButton::South));
    w.postPad(slot: 0, pad: pressing(button: PadButton::East));
    expectDrained(t: t, w: w, name: "within one sample the ups come before the downs",
                  want: "PadButtonDown 0 0; PadButtonUp 0 0; PadButtonDown 0 1");

    Gamepad two = Gamepad.neutral();
    two.press(button: PadButton::North);
    two.press(button: PadButton::West);
    w.postPad(slot: 0, pad: two);
    expectDrained(t: t, w: w, name: "several buttons go up, then down, by their number",
                  want: "PadButtonUp 0 1; PadButtonDown 0 2; PadButtonDown 0 3");

    Window s = Window.headless(width: 64, height: 64);
    s.postPad(slot: 3, pad: pressing(button: PadButton::Guide));
    expectDrained(t: t, w: s, name: "a pad first seen pressing a button connects, then goes down",
                  want: "PadConnected 3; PadButtonDown 3 16");
    s.postPad(slot: 1, pad: Gamepad.neutral());
    Gamepad other = s.pad(slot: 1);
    Gamepad first = s.pad(slot: 3);
    check(t: t, name: "each slot is a pad of its own",
          ok: other.connected && !other.pressed(button: PadButton::Guide) && first.pressed(button: PadButton::Guide),
          why: "the slots read each other's buttons");
    expectDrained(t: t, w: s, name: "a second slot connects apart from the first", want: "PadConnected 1");
}

// Decision 2a: values are reported as the device gives them; only a trigger's press is the package's, at 30 of 255.
unsafe fn void valuesAndTriggers(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    Gamepad g = Gamepad.neutral();
    g.setAxis(axis: PadAxis::LeftX, value: 0.01);
    g.setAxis(axis: PadAxis::RightY, value: -0.73);
    g.setValue(button: PadButton::LeftTrigger, value: 0.5);
    w.postPad(slot: 0, pad: g);
    Gamepad r = w.pad(slot: 0);
    check(t: t, name: "the sticks are reported untouched: no dead zone",
          ok: r.axis(axis: PadAxis::LeftX) == 0.01 && r.axis(axis: PadAxis::RightY) == -0.73
              && r.axis(axis: PadAxis::LeftY) == 0.0,
          why: "a stick read other than sampled");
    check(t: t, name: "a trigger's value is reported untouched", ok: r.value(button: PadButton::LeftTrigger) == 0.5,
          why: "the trigger read other than 0.5");
    expectDrained(t: t, w: w, name: "a trigger half pulled is a down", want: "PadConnected 0; PadButtonDown 0 6");

    Window k = Window.headless(width: 64, height: 64);
    Gamepad below = Gamepad.neutral();
    below.setValue(button: PadButton::RightTrigger, value: cast<float32>(29.0 / 255.0));
    k.postPad(slot: 0, pad: below);
    Gamepad rb = k.pad(slot: 0);
    check(t: t, name: "a trigger at 29 of 255 is not pressed", ok: !rb.pressed(button: PadButton::RightTrigger),
          why: "it reads pressed");
    expectDrained(t: t, w: k, name: "a trigger at 29 of 255 is no down", want: "PadConnected 0");

    Gamepad at = Gamepad.neutral();
    at.setValue(button: PadButton::RightTrigger, value: Gamepad::PressedAt);
    k.postPad(slot: 0, pad: at);
    Gamepad ra = k.pad(slot: 0);
    check(t: t, name: "a trigger at 30 of 255 is pressed", ok: ra.pressed(button: PadButton::RightTrigger),
          why: "it reads not pressed");
    expectDrained(t: t, w: k, name: "a trigger at 30 of 255 is a down", want: "PadButtonDown 0 7");
    check(t: t, name: "the press threshold is 30 of 255", ok: Gamepad::PressedAt == cast<float32>(30.0 / 255.0),
          why: "it is another value");
}

// A disconnect releases what the pad held, then says so; the slot reads disconnected.
unsafe fn void disconnect(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    Gamepad g = Gamepad.neutral();
    g.press(button: PadButton::South);
    g.press(button: PadButton::DpadLeft);
    w.postPad(slot: 2, pad: g);
    w.postPad(slot: 2, pad: Gamepad.disconnected());
    expectDrained(t: t, w: w, name: "a disconnect releases each held button, then disconnects",
                  want: "PadConnected 2; PadButtonDown 2 0; PadButtonDown 2 14; PadButtonUp 2 0; PadButtonUp 2 14; PadDisconnected 2");
    Gamepad gone = w.pad(slot: 2);
    check(t: t, name: "a disconnected slot reads disconnected and at rest",
          ok: !gone.connected && gone.value(button: PadButton::South) == 0.0, why: "connected ${gone.connected}");
    w.postPad(slot: 2, pad: Gamepad.disconnected());
    expectDrained(t: t, w: w, name: "a second disconnect is no event", want: "");
    w.postPad(slot: 2, pad: Gamepad.neutral());
    expectDrained(t: t, w: w, name: "a pad back in the slot connects again", want: "PadConnected 2");
}

// Decision 6: a focus change releases the mouse's buttons, then each pad's, slot by slot, then the keys, then says Focus.
// Unfocused, a pad reads neutral and makes no events (decision 5); after a gain, a button still held comes back as a down
// with the next sample, not before.
unsafe fn void focusRelease(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.post(event: Event::PointerDown(pointer: mouseAt(x: 0.0, y: 0.0), button: PointerButton::Left, mods: 0));
    w.postPad(slot: 1, pad: pressing(button: PadButton::South));
    w.postPad(slot: 0, pad: pressing(button: PadButton::East));
    w.post(event: Event::KeyDown(key: Key::KeyA, mods: 0, repeat: false));
    expectDrained(t: t, w: w, name: "a mouse button, two pads' buttons and a key go down",
                  want: "PointerDown mouse1 0 0 [1]; PadConnected 1; PadButtonDown 1 0; PadConnected 0; PadButtonDown 0 1; KeyDown 4 0 false");
    w.post(event: Event::Focus(focused: false));
    expectDrained(t: t, w: w, name: "a focus loss releases the mouse, then the pads by slot, then the keys",
                  want: "PointerUp mouse1 0 0 [0]; PadButtonUp 0 1; PadButtonUp 1 0; KeyUp 4 0; Focus false");

    Gamepad unfocused = w.pad(slot: 0);
    check(t: t, name: "unfocused, a pad reads neutral but connected",
          ok: unfocused.connected && !unfocused.pressed(button: PadButton::East)
              && unfocused.value(button: PadButton::East) == 0.0,
          why: "it reads disconnected, or East held");
    Gamepad leaning = pressing(button: PadButton::East);
    leaning.setAxis(axis: PadAxis::LeftX, value: 0.9);
    w.postPad(slot: 0, pad: leaning);
    expectDrained(t: t, w: w, name: "unfocused, a sample makes no events", want: "");
    Gamepad stillNeutral = w.pad(slot: 0);
    check(t: t, name: "unfocused, a sample's sticks read centred", ok: stillNeutral.axis(axis: PadAxis::LeftX) == 0.0,
          why: "LeftX reads off centre");

    w.post(event: Event::Focus(focused: true));
    expectDrained(t: t, w: w, name: "a focus gain is only Focus: nothing until the next sample", want: "Focus true");
    Gamepad stale = w.pad(slot: 0);
    check(t: t, name: "after a gain, a pad reads neutral until the next sample",
          ok: !stale.pressed(button: PadButton::East), why: "it reads East pressed");
    w.postPad(slot: 0, pad: leaning);
    expectDrained(t: t, w: w, name: "a button still held comes back as a down with the next sample",
                  want: "PadButtonDown 0 1");
    Gamepad back = w.pad(slot: 0);
    check(t: t, name: "with the next sample a pad reads as sampled",
          ok: back.pressed(button: PadButton::East) && back.axis(axis: PadAxis::LeftX) == 0.9,
          why: "East or LeftX read other than sampled");

    Window g = Window.headless(width: 64, height: 64);
    g.postPad(slot: 0, pad: Gamepad.neutral());
    g.post(event: Event::Focus(focused: false));
    g.postPad(slot: 0, pad: Gamepad.disconnected());
    g.postPad(slot: 1, pad: pressing(button: PadButton::South));
    expectDrained(t: t, w: g, name: "unfocused, a pad still connects and disconnects",
                  want: "PadConnected 0; Focus false; PadDisconnected 0; PadConnected 1");
}

// Decision 5: with pads in the background, a focus change releases no pad, and an unfocused window reads its pads.
unsafe fn void background(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.setPadsWhenUnfocused(on: true);
    w.postPad(slot: 0, pad: pressing(button: PadButton::South));
    w.post(event: Event::KeyDown(key: Key::KeyA, mods: 0, repeat: false));
    w.post(event: Event::Focus(focused: false));
    expectDrained(t: t, w: w, name: "with pads in the background, a focus loss releases the keys and no pad",
                  want: "PadConnected 0; PadButtonDown 0 0; KeyDown 4 0 false; KeyUp 4 0; Focus false");
    w.postPad(slot: 0, pad: pressing(button: PadButton::North));
    expectDrained(t: t, w: w, name: "with pads in the background, an unfocused window's pad makes events",
                  want: "PadButtonUp 0 0; PadButtonDown 0 3");
    Gamepad live = w.pad(slot: 0);
    check(t: t, name: "with pads in the background, an unfocused window reads its pad",
          ok: live.pressed(button: PadButton::North), why: "North reads not pressed");

    w.setPadsWhenUnfocused(on: false);
    expectDrained(t: t, w: w, name: "turned off while unfocused, what the pads hold is released at once",
                  want: "PadButtonUp 0 3");
    Gamepad off = w.pad(slot: 0);
    check(t: t, name: "turned off while unfocused, a pad reads neutral", ok: !off.pressed(button: PadButton::North),
          why: "North reads pressed");
}

// A program's own release (`releaseHeld`) lets go of the pads too, and the next sample brings back what is still held.
unsafe fn void programRelease(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.postPad(slot: 0, pad: pressing(button: PadButton::Start));
    w.post(event: Event::KeyDown(key: Key::KeyA, mods: 0, repeat: false));
    w.releaseHeld();
    expectDrained(t: t, w: w, name: "releaseHeld lets go of a pad's buttons before the keys",
                  want: "PadConnected 0; PadButtonDown 0 9; KeyDown 4 0 false; PadButtonUp 0 9; KeyUp 4 0");
    w.postPad(slot: 0, pad: pressing(button: PadButton::Start));
    expectDrained(t: t, w: w, name: "after releaseHeld, a button still held comes back with the next sample",
                  want: "PadButtonDown 0 9");
}

// A posted pad event moves the pad as the system would: a down presses its button fully, an up lets go, a connect and a
// disconnect do what they say.
unsafe fn void postedEvents(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.post(event: Event::PadButtonDown(slot: 2, button: PadButton::North));
    expectDrained(t: t, w: w, name: "a posted down on a pad not yet seen connects it first",
                  want: "PadConnected 2; PadButtonDown 2 3");
    Gamepad p = w.pad(slot: 2);
    check(t: t, name: "a posted down presses its button fully",
          ok: p.pressed(button: PadButton::North) && p.value(button: PadButton::North) == 1.0, why: "it does not");
    w.post(event: Event::PadButtonDown(slot: 2, button: PadButton::North));
    w.post(event: Event::PadButtonUp(slot: 2, button: PadButton::North));
    w.post(event: Event::PadButtonUp(slot: 2, button: PadButton::North));
    expectDrained(t: t, w: w, name: "posted downs and ups pair as the window holds them", want: "PadButtonUp 2 3");
    w.post(event: Event::PadButtonDown(slot: 2, button: PadButton::DpadUp));
    w.post(event: Event::PadConnected(slot: 2));
    expectDrained(t: t, w: w, name: "a posted connect for a connected pad is no event, and lets go of nothing",
                  want: "PadButtonDown 2 12");
    w.post(event: Event::PadDisconnected(slot: 2));
    expectDrained(t: t, w: w, name: "a posted disconnect releases, then disconnects",
                  want: "PadButtonUp 2 12; PadDisconnected 2");
    w.post(event: Event::PadConnected(slot: 5));
    expectDrained(t: t, w: w, name: "a posted connect connects a pad at rest", want: "PadConnected 5");
    w.post(event: Event::PadButtonUp(slot: 7, button: PadButton::South));
    expectDrained(t: t, w: w, name: "a posted up for a pad never seen is dropped, and connects nothing", want: "");
}

// Slots are 0 to 15; any other is ignored.
unsafe fn void slots(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.postPad(slot: 16, pad: pressing(button: PadButton::South));
    w.postPad(slot: -1, pad: pressing(button: PadButton::South));
    w.post(event: Event::PadButtonDown(slot: 16, button: PadButton::South));
    expectDrained(t: t, w: w, name: "a slot outside 0 to 15 is ignored", want: "");
    Gamepad outside = w.pad(slot: 16);
    check(t: t, name: "a slot outside 0 to 15 reads disconnected", ok: !outside.connected, why: "it reads connected");
    w.postPad(slot: 15, pad: Gamepad.neutral());
    expectDrained(t: t, w: w, name: "slot 15 is the last", want: "PadConnected 15");
    check(t: t, name: "a window has 16 pad slots", ok: Window::PadSlots == 16, why: "another number");
}

// `count` typed characters, which no held-set rule touches: what fills a ring here.
unsafe fn void fill(ref Window w, int32 count) {
    int32 i = 0;
    while (i < count) { w.post(event: Event::Text(c: 'x')); i = i + 1; }
}

// Every event left in the queue, as one string, from the n-th on: what the cases below compare after a run of text.
unsafe fn string tail(ref Window w) {
    string all = "";
    bool reading = true;
    while (reading) {
        Optional<Event> e = w.pollEvent();
        match (e) {
            case Some(value: v): {
                string one = describe(e: v);
                if (one != "Text 120") {
                    if (all.isEmpty()) { all = copy one; } else { all = "${all}; ${one}"; }
                }
            }
            case None: { reading = false; }
        };
    }
    return all;
}

// The ring keeps a slot for each held pad button's up and each connected pad's disconnect, as for a held key's up, so
// a full ring never loses one. A down or a connect counted into a drop was never seen, so the next sample brings it.
unsafe fn void fullRing(ref Tally t) {
    Window w = Window.headless(width: 64, height: 64);
    w.postPad(slot: 0, pad: pressing(button: PadButton::South));
    fill(w: w, count: 300);
    w.postPad(slot: 0, pad: Gamepad.disconnected());
    string got = tail(w: w);
    check(t: t, name: "a full ring still delivers a held pad button's up and the pad's disconnect",
          ok: got.contains(substring: "PadButtonUp 0 0") && got.contains(substring: "PadDisconnected 0"), why: "got `${got}`");

    Window d = Window.headless(width: 64, height: 64);
    fill(w: d, count: 300);
    d.postPad(slot: 0, pad: pressing(button: PadButton::South));
    string dropped = tail(w: d);
    check(t: t, name: "a pad seen while the ring is full is counted into the drop",
          ok: !dropped.contains(substring: "PadConnected") && dropped.contains(substring: "Dropped"), why: "got `${dropped}`");
    Gamepad unseen = d.pad(slot: 0);
    check(t: t, name: "a pad whose connect was dropped reads disconnected", ok: !unseen.connected,
          why: "it reads connected");
    d.postPad(slot: 0, pad: pressing(button: PadButton::South));
    expectDrained(t: t, w: d, name: "the next sample brings a dropped connect and down",
                  want: "PadConnected 0; PadButtonDown 0 0");

    Window k = Window.headless(width: 64, height: 64);
    k.postPad(slot: 0, pad: Gamepad.neutral());
    fill(w: k, count: 300);
    k.postPad(slot: 0, pad: pressing(button: PadButton::East));
    string lost = tail(w: k);
    check(t: t, name: "a known pad's down while the ring is full is counted into the drop",
          ok: lost.contains(substring: "PadConnected 0") && !lost.contains(substring: "PadButtonDown"),
          why: "got `${lost}`");
    k.postPad(slot: 0, pad: pressing(button: PadButton::East));
    expectDrained(t: t, w: k, name: "the next sample brings a dropped down", want: "PadButtonDown 0 1");
}

// A system window opened without the focus starts unfocused, so its pads read neutral (decision 5), unless its options
// ask for pads in the background. Natively; the web's canvas is web.kama's.
@compileFor(!ARCH_WASM32)
unsafe fn void systemWindowPads(ref Tally t) {
    string skip = envOr(name: "KAMA_WINDOW_NO_DISPLAY", dflt: "");
    if (!skip.isEmpty()) { println(s: "skip a system window's pads (KAMA_WINDOW_NO_DISPLAY is set)"); return; }
    Result<Window, WindowError> quiet = Window.openWith(title: "@kama/window pads", width: 160, height: 100,
                                                        options: quietly());
    match (give quiet) {
        case Ok(value: w): {
            w.postPad(slot: 0, pad: pressing(button: PadButton::South));
            expectDrained(t: t, w: w, name: "a system window opened unfocused makes no pad downs",
                          want: "PadConnected 0");
        }
        case Err(error: e): {
            string why = e.message();
            t.verdict(name: "a system window opened unfocused makes no pad downs", why: why);
        }
    };
    WindowOptions o = quietly();
    o.padsWhenUnfocused = true;
    Result<Window, WindowError> behind = Window.openWith(title: "@kama/window pads", width: 160, height: 100,
                                                             options: o);
    match (give behind) {
        case Ok(value: w): {
            w.postPad(slot: 0, pad: pressing(button: PadButton::South));
            expectDrained(t: t, w: w, name: "a system window opened with pads in the background reads them unfocused",
                          want: "PadConnected 0; PadButtonDown 0 0");
        }
        case Err(error: e): {
            string why = e.message();
            t.verdict(name: "a system window opened with pads in the background reads them unfocused", why: why);
        }
    };
}

@compileFor(ARCH_WASM32)
unsafe fn void systemWindowPads(ref Tally t) { }

unsafe fn void padCases(ref Tally t) {
    connectAndPress(t: t);
    valuesAndTriggers(t: t);
    disconnect(t: t);
    focusRelease(t: t);
    background(t: t);
    programRelease(t: t);
    postedEvents(t: t);
    slots(t: t);
    fullRing(t: t);
    systemWindowPads(t: t);
    rawCounts(t: t);
}

// A raw view answers only for the controls it counts: a value past its counts reads at rest, whatever the arrays hold.
unsafe fn void rawCounts(ref Tally t) {
    PadRaw r = PadRaw.none();
    r.buttonCount = 2;
    r.axisCount = 1;
    r.hatCount = 1;
    r.buttons[1] = 1;
    r.buttons[5] = 1;
    r.axes[3] = 0.5;
    r.hats[2] = 4;
    check(t: t, name: "a raw view answers only for the controls it counts",
          ok: r.button(index: 1) && !r.button(index: 5) && r.axis(index: 3) == 0.0 && r.hat(index: 2) == 0
              && !r.button(index: -1),
          why: "a control past the counts read otherwise");
}
