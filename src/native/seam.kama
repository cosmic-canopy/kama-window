// The C seam (csrc/winseam.h), as kama. An extern never leaves its file, so each is published through a wrapper.

export {
    winseam_event,
    KIND_KEY_DOWN, KIND_KEY_UP, KIND_TEXT, KIND_POINTER_MOVE, KIND_POINTER_DOWN, KIND_POINTER_UP, KIND_POINTER_CANCEL,
    KIND_POINTER_ENTER, KIND_POINTER_LEAVE, KIND_SCROLL, KIND_RESIZE, KIND_SCALE_CHANGED, KIND_FOCUS, KIND_POINTER_LOCK,
    KIND_CLOSE_REQUESTED, KIND_DROPPED, KIND_PAD_CONNECTED, KIND_PAD_DISCONNECTED, KIND_PAD_DOWN, KIND_PAD_UP,
    winseam_pad, PAD_SLOTS, PAD_BUTTONS, PAD_AXES, padSample, padRead, setPadsWhenUnfocused,
    openWindow, headlessWindow, closeWindow, holdWindow, releaseWindow, windowClosed, pumpWindow, nextEvent, postEvent,
    releaseHeldInput, windowSize, framebufferSize, windowScale, setCursor, nativeKind, nativeDisplay, nativeWindow, glfwKeyToHid,
};

extern "winseam.h";

comptime int32 KIND_KEY_DOWN = 1;
comptime int32 KIND_KEY_UP = 2;
comptime int32 KIND_TEXT = 3;
comptime int32 KIND_POINTER_MOVE = 4;
comptime int32 KIND_POINTER_DOWN = 5;
comptime int32 KIND_POINTER_UP = 6;
comptime int32 KIND_POINTER_CANCEL = 7;
comptime int32 KIND_POINTER_ENTER = 8;
comptime int32 KIND_POINTER_LEAVE = 9;
comptime int32 KIND_SCROLL = 10;
comptime int32 KIND_RESIZE = 11;
comptime int32 KIND_SCALE_CHANGED = 12;
comptime int32 KIND_FOCUS = 13;
comptime int32 KIND_POINTER_LOCK = 14;
comptime int32 KIND_CLOSE_REQUESTED = 15;
comptime int32 KIND_DROPPED = 16;
comptime int32 KIND_PAD_CONNECTED = 17;
comptime int32 KIND_PAD_DISCONNECTED = 18;
comptime int32 KIND_PAD_DOWN = 19;
comptime int32 KIND_PAD_UP = 20;

comptime int32 PAD_SLOTS = 16;
comptime int32 PAD_BUTTONS = 17;
comptime int32 PAD_AXES = 4;

// One read of a pad; the header owns the layout.
@generate(zero)
type extern value winseam_pad {
    public int32 connected;
    public InlineArray<float32>#(17) buttons;
    public InlineArray<float32>#(4) axes;
}

// One ring record; the header owns the layout, and kama asserts each field against it at build.
@generate(zero)
type extern value winseam_event {
    public int32 kind;
    public int32 a;
    public int32 b;
    public int32 c;
    public float64 x;
    public float64 y;
    public float64 dx;
    public float64 dy;
    public int32 pointer;
    public int32 pointer_kind;
    public int32 primary;
    public int32 buttons;
    public float32 pressure;
    public float32 tilt_x;
    public float32 tilt_y;
    public float32 twist;
    public float32 width;
    public float32 height;
}

extern fn UnsafePtr winseam_open(UnsafeConstPtr<cchar> title, int32 width, int32 height, int32 focused,
                                 UnsafeConstPtr<cchar> canvas, int32 sized_by_page, UnsafePtr<uint8> why,
                                 int32 capacity, UnsafePtr<int32> why_length);
extern fn UnsafePtr winseam_headless(int32 width, int32 height);
extern fn void winseam_close(UnsafePtr window);
extern fn void winseam_hold(UnsafePtr window);
extern fn void winseam_release(UnsafePtr window);
extern fn int32 winseam_closed(UnsafePtr window);
extern fn void winseam_pump(UnsafePtr window);
extern fn int32 winseam_next(UnsafePtr window, UnsafePtr into);
extern fn void winseam_post(UnsafePtr window, UnsafeConstPtr event);
extern fn void winseam_release_held(UnsafePtr window);
extern fn void winseam_size(UnsafePtr window, UnsafePtr<int32> width, UnsafePtr<int32> height);
extern fn void winseam_framebuffer_size(UnsafePtr window, UnsafePtr<int32> width, UnsafePtr<int32> height);
extern fn float32 winseam_scale(UnsafePtr window);
extern fn void winseam_set_cursor(UnsafePtr window, int32 mode);
extern fn int32 winseam_native_kind(UnsafePtr window);
extern fn UnsafePtr winseam_native_display(UnsafePtr window);
extern fn UnsafePtr winseam_native_window(UnsafePtr window);
extern fn int32 winseam_glfw_key_to_hid(int32 glfw_key);
extern fn void winseam_pad_post(UnsafePtr window, int32 slot, int32 connected, UnsafeConstPtr<float32> buttons,
                                UnsafeConstPtr<float32> axes);
extern fn void winseam_pad_read(UnsafePtr window, int32 slot, UnsafePtr into);
extern fn void winseam_set_pads_when_unfocused(UnsafePtr window, int32 on);

unsafe fn void padSample(UnsafePtr window, int32 slot, int32 connected, UnsafeConstPtr<float32> buttons,
                         UnsafeConstPtr<float32> axes) {
    winseam_pad_post(window: window, slot: slot, connected: connected, buttons: buttons, axes: axes);
}
unsafe fn void padRead(UnsafePtr window, int32 slot, UnsafePtr into) { winseam_pad_read(window: window, slot: slot, into: into); }
unsafe fn void setPadsWhenUnfocused(UnsafePtr window, int32 on) { winseam_set_pads_when_unfocused(window: window, on: on); }

unsafe fn UnsafePtr openWindow(UnsafeConstPtr<cchar> title, int32 width, int32 height, int32 focused,
                               UnsafeConstPtr<cchar> canvas, int32 sizedByPage, UnsafePtr<uint8> why, int32 capacity,
                               UnsafePtr<int32> whyLength) {
    return winseam_open(title: title, width: width, height: height, focused: focused, canvas: canvas,
                        sized_by_page: sizedByPage, why: why, capacity: capacity, why_length: whyLength);
}
unsafe fn UnsafePtr headlessWindow(int32 width, int32 height) { return winseam_headless(width: width, height: height); }
unsafe fn void closeWindow(UnsafePtr window) { winseam_close(window: window); }
unsafe fn void holdWindow(UnsafePtr window) { winseam_hold(window: window); }
unsafe fn void releaseWindow(UnsafePtr window) { winseam_release(window: window); }
unsafe fn int32 windowClosed(UnsafePtr window) { return winseam_closed(window: window); }
unsafe fn void pumpWindow(UnsafePtr window) { winseam_pump(window: window); }
unsafe fn int32 nextEvent(UnsafePtr window, UnsafePtr into) { return winseam_next(window: window, into: into); }
unsafe fn void postEvent(UnsafePtr window, UnsafeConstPtr event) { winseam_post(window: window, event: event); }
unsafe fn void releaseHeldInput(UnsafePtr window) { winseam_release_held(window: window); }
unsafe fn void windowSize(UnsafePtr window, UnsafePtr<int32> width, UnsafePtr<int32> height) {
    winseam_size(window: window, width: width, height: height);
}
unsafe fn void framebufferSize(UnsafePtr window, UnsafePtr<int32> width, UnsafePtr<int32> height) {
    winseam_framebuffer_size(window: window, width: width, height: height);
}
unsafe fn float32 windowScale(UnsafePtr window) { return winseam_scale(window: window); }
unsafe fn void setCursor(UnsafePtr window, int32 mode) { winseam_set_cursor(window: window, mode: mode); }
unsafe fn int32 nativeKind(UnsafePtr window) { return winseam_native_kind(window: window); }
unsafe fn UnsafePtr nativeDisplay(UnsafePtr window) { return winseam_native_display(window: window); }
unsafe fn UnsafePtr nativeWindow(UnsafePtr window) { return winseam_native_window(window: window); }
unsafe fn int32 glfwKeyToHid(int32 glfwKey) { return winseam_glfw_key_to_hid(glfw_key: glfwKey); }
