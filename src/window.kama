// @kama/window: a window and its events. The design is kama's (ROADMAP_DETAIL.md § 8, s8-input, KR-26):
//
// - A `Window` is a GLFW window natively, and on the web the page's canvas (WIN-3, AGENTS.window.md item 8), each with
//   its own event queue, so several work. A headless one has the queue and a size and nothing behind them: `post`
//   fills it, for tests, replays and servers.
// - `pump()` is explicit; `pollEvent()` takes one event at a time, in the order they happened, so a resize and a click
//   stay in order. The queue is a fixed ring that coalesces moves, scrolls and resizes, and reports `Dropped(n)` rather
//   than dropping in silence.
// - A `Key` is a physical key, named as the DOM's `KeyboardEvent.code` names it and numbered by its USB HID usage id,
//   whatever the layout; typed text arrives separately, as `Text`.
// - The window keeps what is held (WIN-2, AGENTS.window.md item 5): every up follows its down, every down is followed in
//   time by its up, and a focus change, either way, releases every held button and key before its `Focus`.
// - The mouse, touch and a pen are one stream of pointer events, as the W3C's Pointer Events are (WIN-3,
//   AGENTS.window.md item 8): each carries its `Pointer`, every button has its own down and up, and a focus change
//   cancels a held touch or pen contact.
// - Positions and sizes are logical; `scale()` converts to pixels, and `framebufferSize()` is in pixels.
// - It is not `Sendable`: a window lives on the thread that opened it, which GLFW requires.

import {
    std::collections::DynamicArray,
    std::encoding::utf8::decode, std::encoding::utf8::Utf8Error,
    window::native::winseam_event,
    window::native::KIND_KEY_DOWN, window::native::KIND_KEY_UP, window::native::KIND_TEXT,
    window::native::KIND_POINTER_MOVE, window::native::KIND_POINTER_DOWN, window::native::KIND_POINTER_UP,
    window::native::KIND_POINTER_CANCEL, window::native::KIND_POINTER_ENTER, window::native::KIND_POINTER_LEAVE,
    window::native::KIND_SCROLL,
    window::native::KIND_RESIZE, window::native::KIND_SCALE_CHANGED, window::native::KIND_FOCUS,
    window::native::KIND_POINTER_LOCK, window::native::KIND_CLOSE_REQUESTED, window::native::KIND_DROPPED,
    window::native::KIND_PAD_CONNECTED, window::native::KIND_PAD_DISCONNECTED, window::native::KIND_PAD_DOWN,
    window::native::KIND_PAD_UP, window::native::winseam_pad, window::native::padSample, window::native::padRead,
    window::native::setPadsWhenUnfocused, window::native::padText, window::native::padNumber, window::native::padRumble,
    window::native::openWindow, window::native::headlessWindow, window::native::closeWindow,
    window::native::holdWindow, window::native::releaseWindow, window::native::windowClosed,
    window::native::pumpWindow, window::native::nextEvent, window::native::postEvent, window::native::releaseHeldInput,
    window::native::windowSize,
    window::native::framebufferSize, window::native::windowScale, window::native::setCursor,
    window::native::nativeKind, window::native::nativeDisplay, window::native::nativeWindow,
};

export {
    Window, WindowOptions, WindowError, Event, Key, Pointer, PointerKind, PointerButton, ScrollUnit, Mods, CursorMode,
    Size, NativeKind, NativeWindow, Gamepad, PadButton, PadAxis, PadInfo,
};

type enum WindowError implements Error {
    Refused(string words);   // the system would not open the window, in its words

    public const fn string message() { return match (this) { case Refused(words: w): copy w; }; }
}

// Modifier bits, as `KeyDown`, `KeyUp`, `PointerDown` and `PointerUp` carry them: `(mods & Mods::Shift) != 0`.
type value Mods {
    public comptime uint8 Shift = 1;
    public comptime uint8 Control = 2;
    public comptime uint8 Alt = 4;
    public comptime uint8 Super = 8;
    public comptime uint8 CapsLock = 16;
    public comptime uint8 NumLock = 32;
}

// A pointer's button, numbered as the W3C's `button` is: a touch contact and a pen's tip are `Left`, a pen's barrel
// `Right`. A mouse's sixth to eighth follow the pen's eraser.
type enum PointerButton : uint8 {
    Left = 0, Middle = 1, Right = 2, Back = 3, Forward = 4, Eraser = 5, Sixth = 6, Seventh = 7, Eighth = 8
}

type enum PointerKind : uint8 { Mouse = 0, Touch = 1, Pen = 2 }

// What a `Scroll` counts: lines, which a wheel's notch is natively and a browser may report, or pixels, which a browser
// and a touchpad report. Nothing converts one into the other.
type enum ScrollUnit : uint8 { Lines = 0, Pixels = 1 }

// A gamepad's button, numbered as the W3C's standard gamepad numbers it. The four face buttons are named by their place,
// as a `Key` is: Xbox's A, PlayStation's Cross and Nintendo's B are each `South`. What a pad prints on them is its own.
type enum PadButton : uint8 {
    South = 0, East = 1, West = 2, North = 3, LeftShoulder = 4, RightShoulder = 5, LeftTrigger = 6, RightTrigger = 7,
    Back = 8, Start = 9, LeftStick = 10, RightStick = 11, DpadUp = 12, DpadDown = 13, DpadLeft = 14, DpadRight = 15,
    Guide = 16
}

// A gamepad's stick axis, numbered as the W3C's standard gamepad numbers it: -1 to 1, right and down positive.
type enum PadAxis : uint8 { LeftX = 0, LeftY = 1, RightX = 2, RightY = 3 }

// A gamepad as one read of it: whether a pad is in its slot, each button's travel (0 to 1, by `PadButton`) and each
// stick's axis (-1 to 1, by `PadAxis`), as the device reports them, with no dead zone: shaping a value is the consumer's
// (WIN-4, decision 2a). A button is pressed at `PressedAt` of its travel or more, on every platform.
type value Gamepad {
    public bool connected;
    public InlineArray<float32>#(17) buttons;
    public InlineArray<float32>#(4) axes;

    // 30 of 255 of a button's travel: XInput's trigger threshold, and Chromium's for an XInput pad.
    public comptime float32 PressedAt = 30.0 / 255.0;

    // A pad at rest: connected, every button up, the sticks centred. What a posted sample starts from.
    public ctor neutral() {
        this.connected = true;
        this.buttons = [0.0; 17];
        this.axes = [0.0; 4];
    }

    // An empty slot.
    public ctor disconnected() {
        this.connected = false;
        this.buttons = [0.0; 17];
        this.axes = [0.0; 4];
    }

    public const fn bool pressed(PadButton button) { return this.buttons[cast<isize>(button)] >= Gamepad::PressedAt; }
    public const fn float32 value(PadButton button) { return this.buttons[cast<isize>(button)]; }
    public const fn float32 axis(PadAxis axis) { return this.axes[cast<isize>(axis)]; }

    // `button` all the way down, or all the way up.
    public fn void press(PadButton button) { this.buttons[cast<isize>(button)] = 1.0; }
    public fn void release(PadButton button) { this.buttons[cast<isize>(button)] = 0.0; }
    // `button` at `value` of its travel, 0 to 1.
    public fn void setValue(PadButton button, float32 value) { this.buttons[cast<isize>(button)] = value; }
    public fn void setAxis(PadAxis axis, float32 value) { this.axes[cast<isize>(axis)] = value; }
}

// What the system says of the pad in a slot (`Window.padInfo`): its name; its USB vendor and product, 0 where the system
// gives none; its serial, empty where it has none; the system's own name for the device, which on Windows' GameInput
// held for each pad across every replug and run (WIN-4's measurements); and which rumble it has. Which player a
// returning pad belongs to is the consumer's (decision 4).
type resource PadInfo {
    string padName;
    uint16 vendorId;
    uint16 productId;
    string serialNumber;
    string deviceId;
    int32 caps;

    friend Window::padInfo[made];

    ctor made(string name, uint16 vendor, uint16 product, string serial, string id, int32 caps) {
        this.padName = give name;
        this.vendorId = vendor;
        this.productId = product;
        this.serialNumber = give serial;
        this.deviceId = give id;
        this.caps = caps;
    }

    public const fn string name() { return copy this.padName; }
    public const fn uint16 vendor() { return this.vendorId; }
    public const fn uint16 product() { return this.productId; }
    public const fn string serial() { return copy this.serialNumber; }
    public const fn string id() { return copy this.deviceId; }
    // A strong (low-frequency) and a weak (high-frequency) motor: `Window.rumble`.
    public const fn bool rumble() { return (this.caps & 1) != 0; }
    // A motor in each trigger: `Window.rumbleTriggers`.
    public const fn bool triggerRumble() { return (this.caps & 2) != 0; }
}

// One pointer as an event saw it: a W3C PointerEvent's fields, named as the DOM names them. The mouse is pointer 1;
// each touch contact has an id of its own, never reused. Positions and sizes are logical.
@generate(of)
type value Pointer {
    public int32 id;
    public PointerKind kind;
    public bool primary;      // the first touch contact, the mouse, a pen
    public float64 x;
    public float64 y;
    public uint16 buttons;    // what the window holds for this pointer after the event: a bit per PointerButton
    public float32 pressure;  // 0 to 1; a mouse's is 0.5 while a button is held, else 0
    public float32 tiltX;     // degrees, -90 to 90
    public float32 tiltY;
    public float32 twist;     // degrees, 0 to 359
    public float32 width;     // the contact's size; 1 for a mouse
    public float32 height;

    // A primary pointer of one unit, at `x`, `y`, holding nothing, at rest: what a posted event starts from.
    public ctor at(int32 id, PointerKind kind, float64 x, float64 y) {
        this.id = id;
        this.kind = kind;
        this.primary = true;
        this.x = x;
        this.y = y;
        this.buttons = 0;
        this.pressure = 0.0;
        this.tiltX = 0.0;
        this.tiltY = 0.0;
        this.twist = 0.0;
        this.width = 1.0;
        this.height = 1.0;
    }

    // Whether `buttons` holds `button`.
    public const fn bool pressed(PointerButton button) {
        int32 bit = 1 << cast<int32>(button);
        return (cast<int32>(this.buttons) & bit) != 0;
    }
}

type enum CursorMode { Normal, Hidden, Locked }

@generate(of)
type value Size {
    public int32 width;
    public int32 height;
}

// A physical key: the name is the DOM's `KeyboardEvent.code`, the number its USB HID usage id (the keyboard page).
type enum Key : uint16 {
    Unknown = 0,
    KeyA = 4, KeyB = 5, KeyC = 6, KeyD = 7, KeyE = 8, KeyF = 9, KeyG = 10, KeyH = 11, KeyI = 12, KeyJ = 13, KeyK = 14,
    KeyL = 15, KeyM = 16, KeyN = 17, KeyO = 18, KeyP = 19, KeyQ = 20, KeyR = 21, KeyS = 22, KeyT = 23, KeyU = 24,
    KeyV = 25, KeyW = 26, KeyX = 27, KeyY = 28, KeyZ = 29,
    Digit1 = 30, Digit2 = 31, Digit3 = 32, Digit4 = 33, Digit5 = 34, Digit6 = 35, Digit7 = 36, Digit8 = 37,
    Digit9 = 38, Digit0 = 39,
    Enter = 40, Escape = 41, Backspace = 42, Tab = 43, Space = 44, Minus = 45, Equal = 46, BracketLeft = 47,
    BracketRight = 48, Backslash = 49, IntlHash = 50, Semicolon = 51, Quote = 52, Backquote = 53, Comma = 54,
    Period = 55, Slash = 56, CapsLock = 57,
    F1 = 58, F2 = 59, F3 = 60, F4 = 61, F5 = 62, F6 = 63, F7 = 64, F8 = 65, F9 = 66, F10 = 67, F11 = 68, F12 = 69,
    PrintScreen = 70, ScrollLock = 71, Pause = 72, Insert = 73, Home = 74, PageUp = 75, Delete = 76, End = 77,
    PageDown = 78, ArrowRight = 79, ArrowLeft = 80, ArrowDown = 81, ArrowUp = 82,
    NumLock = 83, NumpadDivide = 84, NumpadMultiply = 85, NumpadSubtract = 86, NumpadAdd = 87, NumpadEnter = 88,
    Numpad1 = 89, Numpad2 = 90, Numpad3 = 91, Numpad4 = 92, Numpad5 = 93, Numpad6 = 94, Numpad7 = 95, Numpad8 = 96,
    Numpad9 = 97, Numpad0 = 98, NumpadDecimal = 99, IntlBackslash = 100, ContextMenu = 101, NumpadEqual = 103,
    F13 = 104, F14 = 105, F15 = 106, F16 = 107, F17 = 108, F18 = 109, F19 = 110, F20 = 111, F21 = 112, F22 = 113,
    F23 = 114, F24 = 115,
    ControlLeft = 224, ShiftLeft = 225, AltLeft = 226, MetaLeft = 227, ControlRight = 228, ShiftRight = 229,
    AltRight = 230, MetaRight = 231
}

type enum Event {
    KeyDown(Key key, uint8 mods, bool repeat),
    KeyUp(Key key, uint8 mods),
    Text(char c),
    PointerMove(Pointer pointer, float64 dx, float64 dy),        // locked, x and y mean nothing and dx, dy are raw
    PointerDown(Pointer pointer, PointerButton button, uint8 mods),
    PointerUp(Pointer pointer, PointerButton button, uint8 mods),
    PointerCancel(Pointer pointer),                              // it ends, with no up: the system or a focus change took it
    PointerEnter(Pointer pointer),
    PointerLeave(Pointer pointer),
    Scroll(float64 dx, float64 dy, ScrollUnit unit),             // positive is left and up, as GLFW and winit report
    Resize(int32 width, int32 height),
    ScaleChanged(float32 scale),
    Focus(bool focused),
    PointerLock(bool locked),
    CloseRequested,
    PadConnected(int32 slot),                                  // a pad in `slot`, 0 to 15; `Window.pad(slot)` reads it
    PadDisconnected(int32 slot),                               // after an up for each button it held
    PadButtonDown(int32 slot, PadButton button),
    PadButtonUp(int32 slot, PadButton button),
    Dropped(int32 count)                                       // the queue was full: this many events were lost
}

// Whose handles a `NativeWindow` holds.
type enum NativeKind { None, Win32, X11, Wayland, Cocoa, Canvas }

// What a GPU surface is made from: a window's system handles, `kind()` saying whose. It holds the window's native
// record, so the handles stay valid for as long as it lives, after its `Window` has closed too; a copy is another hold.
// The record, and the system window behind it, go with the last of the `Window` and its handles (AGENTS.window.md
// item 6). Once the `Window` is dropped, `isOpen()` is false, and nothing should present to it again.
type resource NativeWindow implements Copyable<This>(bare: give) {
    NativeKind system;
    UnsafePtr displayHandle;   // HINSTANCE, Display*, wl_display*
    UnsafePtr windowHandle;    // HWND, X11 Window, wl_surface*, NSWindow*, the canvas selector's C string
    UnsafePtr record;          // the window's record, held; null when adopted

    friend Window::nativeHandle[fromRecord];

    unsafe ctor fromRecord(UnsafePtr record, NativeKind kind, UnsafePtr display, UnsafePtr window) {
        this.system = kind;
        this.displayHandle = display;
        this.windowHandle = window;
        this.record = record;
        holdWindow(window: record);
    }

    // The handles of a window made elsewhere. It holds nothing: whoever made the window keeps it alive while this
    // lives, and it is always open.
    public unsafe ctor adopt(NativeKind kind, UnsafePtr display, UnsafePtr window) {
        this.system = kind;
        this.displayHandle = display;
        this.windowHandle = window;
        this.record = null;
    }

    public unsafe ctor copy(ref NativeWindow source) {
        this.system = source.system;
        this.displayHandle = source.displayHandle;
        this.windowHandle = source.windowHandle;
        this.record = source.record;
        if (this.record != null) { holdWindow(window: this.record); }
    }

    public const fn NativeKind kind() { return this.system; }
    public unsafe const fn UnsafePtr display() { return this.displayHandle; }
    public unsafe const fn UnsafePtr window() { return this.windowHandle; }

    // False once the window's `Window` is dropped. The handles stay valid while this lives, but the window is closed:
    // hidden, its events gone, never shown again.
    public unsafe const fn bool isOpen() {
        if (this.record == null) { return true; }
        return windowClosed(window: this.record) == 0;
    }

    // The window's size in pixels, as its `Window.framebufferSize()` gives it (as of the last `pump()`), for what holds
    // this handle and not the `Window`: a GPU surface configures at it, so the window stays the one writer of a canvas's
    // pixels (WIN-20). 0 × 0 once the window is closed, and for a handle adopted from elsewhere, whose maker knows it.
    public unsafe const fn Size framebufferSize() {
        Size s = Size.of(width: 0, height: 0);
        if (this.record == null || windowClosed(window: this.record) != 0) { return s; }
        framebufferSize(window: this.record, width: addr(of: s.width), height: addr(of: s.height));
        return s;
    }

    unsafe ~NativeWindow() { if (this.record != null) { releaseWindow(window: this.record); } }
}

unsafe fn Key keyOf(int32 hid) {
    if (hid < 0 || hid > 65535) { return Key::Unknown; }
    Optional<Key> k = try cast<Key>(cast<uint16>(hid));
    return match (k) {
        case Some(value: v): v;
        case None: Key::Unknown;
    };
}

// The ring holds only the buttons PointerButton names (it drops any other), so the fallback is never taken.
unsafe fn PointerButton buttonOf(int32 n) {
    if (n < 0 || n > 255) { return PointerButton::Left; }
    Optional<PointerButton> b = try cast<PointerButton>(cast<uint8>(n));
    return match (b) {
        case Some(value: v): v;
        case None: PointerButton::Left;
    };
}

// The pad info text `which` (0 the name, 1 the serial, 2 the id) of `slot`; "" when there is none.
unsafe fn string padString(UnsafePtr window, int32 slot, int32 which) {
    InlineArray<uint8>#(256) buffer = [0; 256];
    int32 n = padText(window: window, slot: slot, which: which, into: addr(of: buffer[0]), capacity: 256);
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize i = 0;
    while (i < cast<isize>(n)) { bytes.add(item: buffer[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    return match (give r) {
        case Ok(value: t): give t;
        case Err(error: e): "";
    };
}

// The ring numbers only the buttons PadButton names, so the fallback is never taken.
unsafe fn PadButton padButtonOf(int32 n) {
    if (n < 0 || n > 255) { return PadButton::South; }
    Optional<PadButton> b = try cast<PadButton>(cast<uint8>(n));
    return match (b) {
        case Some(value: v): v;
        case None: PadButton::South;
    };
}

unsafe fn PointerKind pointerKindOf(int32 n) {
    if (n == 1) { return PointerKind::Touch; }
    if (n == 2) { return PointerKind::Pen; }
    return PointerKind::Mouse;
}

// The pointer a ring record carries.
unsafe fn Pointer pointerOf(const ref winseam_event e) {
    return Pointer.of(id: e.pointer, kind: pointerKindOf(n: e.pointer_kind), primary: e.primary != 0, x: e.x, y: e.y,
                      buttons: truncate<uint16>(e.buttons), pressure: e.pressure, tiltX: e.tilt_x, tiltY: e.tilt_y,
                      twist: e.twist, width: e.width, height: e.height);
}

// A pointer into a ring record.
unsafe fn void setPointer(ref winseam_event e, const ref Pointer p) {
    e.pointer = p.id;
    e.pointer_kind = cast<int32>(p.kind);
    if (p.primary) { e.primary = 1; }
    e.x = p.x;
    e.y = p.y;
    e.buttons = cast<int32>(p.buttons);
    e.pressure = p.pressure;
    e.tilt_x = p.tiltX;
    e.tilt_y = p.tiltY;
    e.twist = p.twist;
    e.width = p.width;
    e.height = p.height;
}

unsafe fn uint8 modsOf(int32 n) { return truncate<uint8>(n & 63); }

// A ring record as an Event.
unsafe fn Event eventOf(const ref winseam_event e) {
    int32 k = e.kind;
    if (k == KIND_KEY_DOWN) { return Event::KeyDown(key: keyOf(hid: e.a), mods: modsOf(n: e.b), repeat: e.c != 0); }
    if (k == KIND_KEY_UP) { return Event::KeyUp(key: keyOf(hid: e.a), mods: modsOf(n: e.b)); }
    if (k == KIND_TEXT) { return Event::Text(c: cast<char>(cast<uint32>(e.a))); }
    if (k == KIND_POINTER_MOVE) { return Event::PointerMove(pointer: pointerOf(e: e), dx: e.dx, dy: e.dy); }
    if (k == KIND_POINTER_DOWN) {
        return Event::PointerDown(pointer: pointerOf(e: e), button: buttonOf(n: e.a), mods: modsOf(n: e.b));
    }
    if (k == KIND_POINTER_UP) {
        return Event::PointerUp(pointer: pointerOf(e: e), button: buttonOf(n: e.a), mods: modsOf(n: e.b));
    }
    if (k == KIND_POINTER_CANCEL) { return Event::PointerCancel(pointer: pointerOf(e: e)); }
    if (k == KIND_POINTER_ENTER) { return Event::PointerEnter(pointer: pointerOf(e: e)); }
    if (k == KIND_POINTER_LEAVE) { return Event::PointerLeave(pointer: pointerOf(e: e)); }
    if (k == KIND_SCROLL) {
        ScrollUnit unit = ScrollUnit::Lines;
        if (e.a == 1) { unit = ScrollUnit::Pixels; }
        return Event::Scroll(dx: e.dx, dy: e.dy, unit: unit);
    }
    if (k == KIND_RESIZE) { return Event::Resize(width: e.a, height: e.b); }
    if (k == KIND_SCALE_CHANGED) { return Event::ScaleChanged(scale: cast<float32>(e.x)); }
    if (k == KIND_FOCUS) { return Event::Focus(focused: e.a != 0); }
    if (k == KIND_POINTER_LOCK) { return Event::PointerLock(locked: e.a != 0); }
    if (k == KIND_CLOSE_REQUESTED) { return Event::CloseRequested; }
    if (k == KIND_PAD_CONNECTED) { return Event::PadConnected(slot: e.a); }
    if (k == KIND_PAD_DISCONNECTED) { return Event::PadDisconnected(slot: e.a); }
    if (k == KIND_PAD_DOWN) { return Event::PadButtonDown(slot: e.a, button: padButtonOf(n: e.b)); }
    if (k == KIND_PAD_UP) { return Event::PadButtonUp(slot: e.a, button: padButtonOf(n: e.b)); }
    return Event::Dropped(count: e.a);
}

// An Event as a ring record, for `post`.
unsafe fn winseam_event recordOf(const ref Event event) {
    winseam_event e = winseam_event.zero();
    match (event) {
        case KeyDown(key: key, mods: mods, repeat: repeat): {
            e.kind = KIND_KEY_DOWN; e.a = cast<int32>(key); e.b = cast<int32>(mods);
            if (repeat) { e.c = 1; }
        }
        case KeyUp(key: key, mods: mods): { e.kind = KIND_KEY_UP; e.a = cast<int32>(key); e.b = cast<int32>(mods); }
        case Text(c: c): { e.kind = KIND_TEXT; e.a = cast<int32>(c); }
        case PointerMove(pointer: p, dx: dx, dy: dy): { e.kind = KIND_POINTER_MOVE; setPointer(e: e, p: p); e.dx = dx; e.dy = dy; }
        case PointerDown(pointer: p, button: button, mods: mods): {
            e.kind = KIND_POINTER_DOWN; setPointer(e: e, p: p); e.a = cast<int32>(button); e.b = cast<int32>(mods);
        }
        case PointerUp(pointer: p, button: button, mods: mods): {
            e.kind = KIND_POINTER_UP; setPointer(e: e, p: p); e.a = cast<int32>(button); e.b = cast<int32>(mods);
        }
        case PointerCancel(pointer: p): { e.kind = KIND_POINTER_CANCEL; setPointer(e: e, p: p); }
        case PointerEnter(pointer: p): { e.kind = KIND_POINTER_ENTER; setPointer(e: e, p: p); }
        case PointerLeave(pointer: p): { e.kind = KIND_POINTER_LEAVE; setPointer(e: e, p: p); }
        case Scroll(dx: dx, dy: dy, unit: unit): {
            e.kind = KIND_SCROLL; e.dx = dx; e.dy = dy;
            if (unit == ScrollUnit::Pixels) { e.a = 1; }
        }
        case Resize(width: w, height: h): { e.kind = KIND_RESIZE; e.a = w; e.b = h; }
        case ScaleChanged(scale: s): { e.kind = KIND_SCALE_CHANGED; e.x = cast<float64>(s); }
        case Focus(focused: f): { e.kind = KIND_FOCUS; if (f) { e.a = 1; } }
        case PointerLock(locked: l): { e.kind = KIND_POINTER_LOCK; if (l) { e.a = 1; } }
        case CloseRequested: { e.kind = KIND_CLOSE_REQUESTED; }
        case PadConnected(slot: s): { e.kind = KIND_PAD_CONNECTED; e.a = s; }
        case PadDisconnected(slot: s): { e.kind = KIND_PAD_DISCONNECTED; e.a = s; }
        case PadButtonDown(slot: s, button: b): { e.kind = KIND_PAD_DOWN; e.a = s; e.b = cast<int32>(b); }
        case PadButtonUp(slot: s, button: b): { e.kind = KIND_PAD_UP; e.a = s; e.b = cast<int32>(b); }
        case Dropped(count: n): { e.kind = KIND_DROPPED; e.a = n; }
    };
    return e;
}

// How a system window opens (`Window.openWith`), each field public with its default, as kama's `std::net` options are:
// - `focused`: the window takes the keyboard focus as it opens; true by default, since a game takes the focus at
//   launch. False opens it behind whatever has the focus, as a tool's or a test's window should. Natively it is GLFW's
//   `GLFW_FOCUSED` and `GLFW_FOCUS_ON_SHOW`; on the web the canvas is focused, or left until the user clicks it.
// - `sizedByPage`: on the web, the page lays the canvas out, and `width` and `height` go unused; false by default, so
//   the window sets the canvas's CSS size, as a native window opens at its size. Natively, nothing.
// - `padsWhenUnfocused`: the window reads its pads while it is unfocused; false by default, so a pad reads neutral and
//   makes no events while the player is in another program (WIN-4, decision 5). `Window.setPadsWhenUnfocused` changes
//   it later, for a settings screen.
type value WindowOptions {
    public bool focused = true;
    public bool sizedByPage = false;
    public bool padsWhenUnfocused = false;

    public ctor make() { }
}

type resource Window {
    UnsafePtr seam;

    // A system window, `width` × `height` logical, titled `title`, opened as `WindowOptions.make()` says: focused.
    public unsafe ctor Result<Window, WindowError> open(const ref string title, int32 width, int32 height) {
        return Window.openWith(title: title, width: width, height: height, options: WindowOptions.make());
    }

    // A system window, `width` × `height` logical, titled `title`, opened as `options` say. On the web, the page's
    // `#canvas` (emscripten's own name for a program's canvas), and the title is the page's.
    public unsafe ctor Result<Window, WindowError> openWith(const ref string title, int32 width, int32 height,
                                                            const ref WindowOptions options) {
        return Window.openIn(canvas: "#canvas", title: title, width: width, height: height, options: options);
    }

    // A system window as `openWith` opens one, on the web on the page's canvas that `canvas` (a CSS selector) names:
    // which canvas is what the window is, so it is spelled, as `std::net` spells an address (AGENTS.window.md item 8,
    // decision 11). Several canvases are several windows. Natively `canvas` goes unused, as the web leaves `title` to
    // the page, so a program's canvases are its windows natively with the same code.
    public unsafe ctor Result<Window, WindowError> openIn(const ref string canvas, const ref string title, int32 width,
                                                          int32 height, const ref WindowOptions options) {
        InlineArray<uint8>#(512) why = [0; 512];
        int32 whyLength = 0;
        int32 focused = 0;
        if (options.focused) { focused = 1; }
        int32 sizedByPage = 0;
        if (options.sizedByPage) { sizedByPage = 1; }
        UnsafePtr s = openWindow(title: title.cstr(), width: width, height: height, focused: focused,
                                 canvas: canvas.cstr(), sizedByPage: sizedByPage, why: addr(of: why[0]), capacity: 512,
                                 whyLength: addr(of: whyLength));
        if (s == null) {
            DynamicArray<uint8> bytes = DynamicArray.empty();
            isize i = 0;
            while (i < cast<isize>(whyLength)) { bytes.add(item: why[i]); i = i + 1; }
            Result<string, Utf8Error> r = decode(bytes: bytes.view());
            string words = match (give r) {
                case Ok(value: t): give t;
                case Err(error: e): "(not UTF-8)";
            };
            return Result::Err(error: WindowError::Refused(words: give words));
        }
        if (options.padsWhenUnfocused) { setPadsWhenUnfocused(window: s, on: 1); }
        return Result::Ok(value: Window.adopt(seam: s));
    }

    // A window with nothing behind it: its queue, filled by `post`, and its size. Never touches the system.
    public unsafe ctor headless(int32 width, int32 height) { this.seam = headlessWindow(width: width, height: height); }

    unsafe ctor adopt(UnsafePtr seam) { this.seam = seam; }

    // Take the system's pending events into the queue (every open window's, natively). Headless, nothing.
    public unsafe fn void pump() { if (this.seam != null) { pumpWindow(window: this.seam); } }

    // The next event, oldest first; None when the queue is empty.
    public unsafe fn Optional<Event> pollEvent() {
        if (this.seam == null) { return Optional::None; }
        winseam_event e = winseam_event.zero();
        if (nextEvent(window: this.seam, into: cast<UnsafePtr>(addr(of: e))) == 0) { return Optional::None; }
        return Optional::Some(value: eventOf(e: e));
    }

    // An event into the queue as if the system had sent it: coalesced like one, and moving what is held like one, so a
    // posted Focus releases what is held first. A Resize also sets the size.
    public unsafe fn void post(const ref Event event) {
        if (this.seam == null) { return; }
        winseam_event e = recordOf(event: event);
        postEvent(window: this.seam, event: cast<UnsafeConstPtr>(addr(of: e)));
    }

    // The end of every held pointer (a mouse's buttons up, a touch or pen contact cancelled), then an up for every held
    // key, as a focus change makes them and with no Focus after: a program's own release, for a reason only it knows (a
    // remote desktop that drops key ups, a long stall).
    public unsafe fn void releaseHeld() {
        if (this.seam == null) { return; }
        releaseHeldInput(window: this.seam);
    }

    // A window's pad slots, 0 to 15: a pad keeps its slot while it is connected, and a new one takes the lowest free.
    public comptime int32 PadSlots = 16;

    // The pad in `slot` as of the last `pump()`: neutral while the window is unfocused (unless it reads pads in the
    // background) and after a release, until the pad's next sample; disconnected for an empty slot or one outside 0 to
    // 15. Connected from its `PadConnected` until its `PadDisconnected`.
    public unsafe const fn Gamepad pad(int32 slot) {
        Gamepad g = Gamepad.disconnected();
        if (this.seam == null) { return g; }
        winseam_pad p = winseam_pad.zero();
        padRead(window: this.seam, slot: slot, into: cast<UnsafePtr>(addr(of: p)));
        g.connected = p.connected != 0;
        // Element by element: a whole InlineArray assigned to or from an extern value's array field lowers to a C array
        // assignment, which C refuses (KAMA_GAPS.md).
        isize i = 0;
        while (i < 17) { g.buttons[i] = p.buttons[i]; i = i + 1; }
        i = 0;
        while (i < 4) { g.axes[i] = p.axes[i]; i = i + 1; }
        return g;
    }

    // A pad's sample into `slot` as if the system had read it (a test, a replay): compared with what the window has
    // queued, it makes the slot's connect, disconnect, downs and ups. A slot outside 0 to 15 is ignored.
    public unsafe fn void postPad(int32 slot, const ref Gamepad pad) {
        if (this.seam == null) { return; }
        int32 connected = 0;
        if (pad.connected) { connected = 1; }
        // By its parts: kama cannot yet write into an extern value's array (KAMA_GAPS.md).
        padSample(window: this.seam, slot: slot, connected: connected, buttons: addr(of: pad.buttons[0]),
                  axes: addr(of: pad.axes[0]));
    }

    // What the system says of the pad in `slot`, while the window knows a pad there (from its `PadConnected` to its
    // `PadDisconnected`); None for an empty slot, and always for a headless window, which has no system behind it.
    public unsafe const fn Optional<PadInfo> padInfo(int32 slot) {
        if (this.seam == null) { return Optional::None; }
        int32 vendor = padNumber(window: this.seam, slot: slot, which: 0);
        if (vendor < 0) { return Optional::None; }
        int32 product = padNumber(window: this.seam, slot: slot, which: 1);
        string name = padString(window: this.seam, slot: slot, which: 0);
        string serial = padString(window: this.seam, slot: slot, which: 1);
        string id = padString(window: this.seam, slot: slot, which: 2);
        int32 caps = padNumber(window: this.seam, slot: slot, which: 2);
        return Optional::Some(value: PadInfo.made(name: give name, vendor: cast<uint16>(vendor),
                                                product: cast<uint16>(product), serial: give serial, id: give id,
                                                caps: caps));
    }

    // Rumble on the pad in `slot` (WIN-4, decision 7): `strong` its low-frequency motor and `weak` its high-frequency
    // one, each clamped to 0 to 1, for `milliseconds`; all 0 stops it. True when the system took it; false when there is
    // no pad there, the window is headless, the pad has no such motors (`PadInfo.rumble`), or the window's pads read
    // neutral: unfocused, with pads not read in the background. A focus loss that closes the pads stops each rumble the
    // window started, as it releases each held button.
    public unsafe fn bool rumble(int32 slot, float32 strong, float32 weak, int32 milliseconds) {
        if (this.seam == null) { return false; }
        return padRumble(window: this.seam, slot: slot, a: strong, b: weak, milliseconds: milliseconds, triggers: false) != 0;
    }

    // Rumble in the triggers of the pad in `slot`, `left` and `right` each 0 to 1, as `rumble` is: false when the pad has
    // no trigger motors (`PadInfo.triggerRumble`).
    public unsafe fn bool rumbleTriggers(int32 slot, float32 left, float32 right, int32 milliseconds) {
        if (this.seam == null) { return false; }
        return padRumble(window: this.seam, slot: slot, a: left, b: right, milliseconds: milliseconds, triggers: true) != 0;
    }

    // Whether the window reads its pads while it is unfocused (WindowOptions.padsWhenUnfocused). Turned off while
    // unfocused, what the pads hold is released at once.
    public unsafe fn void setPadsWhenUnfocused(bool on) {
        if (this.seam == null) { return; }
        int32 o = 0;
        if (on) { o = 1; }
        setPadsWhenUnfocused(window: this.seam, on: o);
    }

    // Logical size.
    public unsafe const fn Size size() {
        Size s = Size.of(width: 0, height: 0);
        if (this.seam != null) { windowSize(window: this.seam, width: addr(of: s.width), height: addr(of: s.height)); }
        return s;
    }

    // Size in pixels.
    public unsafe const fn Size framebufferSize() {
        Size s = Size.of(width: 0, height: 0);
        if (this.seam != null) {
            framebufferSize(window: this.seam, width: addr(of: s.width), height: addr(of: s.height));
        }
        return s;
    }

    // Pixels per logical unit.
    public unsafe const fn float32 scale() {
        if (this.seam == null) { return 1.0; }
        return windowScale(window: this.seam);
    }

    // Normal, hidden, or locked (hidden with raw, unbounded motion); a PointerLock event says when a lock takes hold.
    public unsafe fn void setCursor(CursorMode mode) {
        if (this.seam == null) { return; }
        int32 m = match (mode) {
            case Normal: 0;
            case Hidden: 1;
            case Locked: 2;
        };
        setCursor(window: this.seam, mode: m);
    }

    // The system's handles, for a GPU surface, holding the window's record: valid while the handle lives, after this
    // window is dropped too. Kind None for a headless window; Canvas on the web, its window the canvas's selector;
    // natively on Windows only so far.
    public unsafe const fn NativeWindow nativeHandle() {
        if (this.seam == null) { return NativeWindow.adopt(kind: NativeKind::None, display: null, window: null); }
        NativeKind kind = NativeKind::None;
        int32 k = nativeKind(window: this.seam);
        if (k == 1) { kind = NativeKind::Win32; }
        if (k == 2) { kind = NativeKind::X11; }
        if (k == 3) { kind = NativeKind::Wayland; }
        if (k == 4) { kind = NativeKind::Cocoa; }
        if (k == 5) { kind = NativeKind::Canvas; }
        return NativeWindow.fromRecord(record: this.seam, kind: kind, display: nativeDisplay(window: this.seam),
                                       window: nativeWindow(window: this.seam));
    }

    // Closes the window as the user sees it at once: hidden, its events gone. The system window itself goes with the
    // last of this and the handles taken from it.
    unsafe ~Window() { closeWindow(window: this.seam); }
}
